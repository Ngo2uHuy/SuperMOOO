<ui:FluentWindow x:Class="SuperMOOO.App.Shell.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="SuperMOOO" Width="1440" Height="900" MinWidth="1024" MinHeight="640"
                 WindowStartupLocation="CenterScreen" WindowState="Maximized" ExtendsContentIntoTitleBar="True" WindowCornerPreference="Round">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:NavigationView x:Name="Nav" PaneDisplayMode="Left" OpenPaneLength="264" FrameMargin="0"
                       IsBackButtonVisible="Collapsed" IsPaneToggleVisible="True" IsTopSeparatorVisible="False" IsFooterSeparatorVisible="True"
                       TitleBar="{Binding ElementName=TitleBar, Mode=OneWay}" Transition="FadeIn" TransitionDuration="120">
      <ui:NavigationView.AutoSuggestBox>
        <ui:AutoSuggestBox x:Name="Search" PlaceholderText="Tìm màn hình, tác vụ… (Ctrl+K)" MaxSuggestionListHeight="420">
          <ui:AutoSuggestBox.Icon>
            <ui:IconSourceElement>
              <ui:SymbolIconSource Symbol="Search24" />
            </ui:IconSourceElement>
          </ui:AutoSuggestBox.Icon>
          <ui:AutoSuggestBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,2">
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </DataTemplate>
          </ui:AutoSuggestBox.ItemTemplate>
        </ui:AutoSuggestBox>
      </ui:NavigationView.AutoSuggestBox>
      <ui:NavigationView.ContentOverlay>
        <Grid>
          <ui:SnackbarPresenter x:Name="Snackbar" />
        </Grid>
      </ui:NavigationView.ContentOverlay>
    </ui:NavigationView>

    <ui:TitleBar x:Name="TitleBar" Title="{Binding Selected.Title, StringFormat='SuperMOOO — {0}', FallbackValue=SuperMOOO}"
                 CloseWindowByDoubleClickOnIcon="True">
      <ui:TitleBar.Icon>
        <ui:SymbolIcon Symbol="VideoClip24" Filled="True" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <!-- Thanh trạng thái: tình trạng hàng đợi luôn nhìn thấy, bấm để sang màn Tác vụ. -->
    <Border Grid.Row="1" Background="{DynamicResource StatusBarBackground}" Padding="8,0,16,0" MinHeight="28">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Command="NavigationCommands.GoToPage" CommandParameter="S15" Cursor="Hand" ToolTip="Mở màn Tác vụ"
                Background="Transparent" BorderThickness="0" Padding="6,3" Focusable="False">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bg" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                <ContentPresenter VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
          <StackPanel Orientation="Horizontal">
            <ui:ProgressRing IsIndeterminate="True" Width="12" Height="12" Margin="0,0,8,0" Foreground="White"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding JobSummary}" FontSize="12" FontWeight="SemiBold" Foreground="White" />
          </StackPanel>
        </Button>
        <TextBlock Grid.Column="1" Margin="16,0" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"
                   Text="{Binding Selected.Description}" Foreground="#D6E4F7" />
        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{Binding Version}"
                   Foreground="White" />
      </Grid>
    </Border>

    <ui:ContentDialogHost x:Name="DialogHost" Grid.RowSpan="2" />
  </Grid>
</ui:FluentWindow>
