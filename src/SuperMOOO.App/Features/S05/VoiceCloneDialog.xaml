<ui:FluentWindow x:Class="SuperMOOO.App.Features.S05.VoiceCloneDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:c="clr-namespace:SuperMOOO.App.Controls"
                 Title="Clone giọng (OmniVoice)" Width="600" Height="680" WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True" ShowInTaskbar="False" ResizeMode="CanResize">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <ui:TitleBar Title="Clone giọng (OmniVoice)" ShowMinimize="False" ShowMaximize="False" />
    <DockPanel Grid.Row="1" Margin="24,8,24,24">
      <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,16"
                 Text="Audio mẫu 3–30 giây có tiếng rõ; nhập đúng lời nói trong mẫu. Giọng clone dùng được ở mọi màn có chọn giọng." />
      <StackPanel DockPanel.Dock="Top">
        <c:Field Header="Tên giọng">
          <ui:TextBox Text="{Binding VoiceName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Giọng của tôi" />
        </c:Field>
        <c:Field Header="Audio mẫu">
          <DockPanel>
            <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Chọn file audio…"
                       Command="{Binding BrowseAudioCommand}" />
            <ui:TextBox Text="{Binding ReferenceAudio, UpdateSourceTrigger=PropertyChanged}" c:FileDrop.IsEnabled="True" PlaceholderText="Chọn hoặc kéo-thả file audio" />
          </DockPanel>
        </c:Field>
        <c:Field Header="Lời nói trong mẫu">
          <ui:TextBox Text="{Binding ReferenceText, UpdateSourceTrigger=PropertyChanged}" Height="72" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" />
        </c:Field>
        <c:Field Header="Ngôn ngữ">
          <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" DisplayMemberPath="Display" />
        </c:Field>
        <StackPanel Orientation="Horizontal">
          <ui:Button Appearance="Primary" Content="Lưu giọng" Icon="{ui:SymbolIcon Save24}" Command="{Binding EnrollCommand}" />
          <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="12,0,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
        <TextBlock Style="{StaticResource Hint}" Text="{Binding Status}" Margin="0,8,0,0" />
      </StackPanel>
      <DockPanel Margin="0,16,0,0">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <TextBlock Style="{StaticResource CardTitle}" Text="Giọng đã clone" Margin="0" VerticalAlignment="Center" />
          <ui:Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Delete24}" ToolTip="Xoá giọng đang chọn"
                     Command="{Binding DeleteCommand}" />
        </DockPanel>
        <ListBox ItemsSource="{Binding Clones}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name" />
      </DockPanel>
    </DockPanel>
    <ui:ContentDialogHost Grid.RowSpan="2" />
  </Grid>
</ui:FluentWindow>
