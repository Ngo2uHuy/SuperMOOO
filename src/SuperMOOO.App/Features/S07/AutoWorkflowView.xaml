<UserControl x:Class="SuperMOOO.App.Features.S07.AutoWorkflowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:SuperMOOO.App.Controls"
             xmlns:local="clr-namespace:SuperMOOO.App.Features.S07"
             AllowDrop="True">
  <DockPanel Margin="{StaticResource PagePadding}">
    <c:ScreenHeader DockPanel.Dock="Top" Title="Auto A→Z"
                    Description="Chọn một chế độ, thêm nguồn (file, thư mục hoặc liên kết), app tự chạy trọn quy trình và có thể xếp video vào lịch đăng.">
      <ui:Button Appearance="Primary" Content="Chạy tự động" Icon="{ui:SymbolIcon Flowchart24}" Command="{Binding StartCommand}" />
    </c:ScreenHeader>

    <c:SplitView PrimaryRatio="1.1">
      <c:SplitView.Primary>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,0,16,0">
            <ui:Card Style="{StaticResource Section}">
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="Chế độ &amp; nguồn" />
                <c:Field Header="Chế độ">
                  <ComboBox ItemsSource="{x:Static local:AutoWorkflowViewModel.Modes}" SelectedItem="{Binding Mode}" DisplayMemberPath="Label" />
                </c:Field>
                <ui:InfoBar Title="Đã bỏ" IsOpen="True" IsClosable="False" Severity="Informational" Margin="0,0,0,12"
                            Message="Chế độ &quot;Mô tả → video AI&quot; và &quot;Dự án timeline → video&quot; không còn. Video xuất từ ArtCraft dùng được làm nguồn cho mọi chế độ." />
                <c:Field Header="Nguồn" Hint="Mỗi dòng một nguồn: file, thư mục hoặc liên kết video. Tối đa 50.">
                  <StackPanel>
                    <ui:TextBox Text="{Binding SourcesText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="84" MaxHeight="150"
                                VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                PlaceholderText="Kéo thả file/thư mục vào đây, hoặc dán liên kết…" />
                    <WrapPanel Margin="0,8,0,0">
                      <ui:Button Style="{StaticResource ToolButton}" Content="Thêm file" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddFilesCommand}" />
                      <ui:Button Style="{StaticResource ToolButton}" Content="Thêm thư mục" Icon="{ui:SymbolIcon FolderAdd24}" Command="{Binding AddFolderCommand}" />
                    </WrapPanel>
                  </StackPanel>
                </c:Field>
                <c:Field Header="Hoặc nhập văn bản" Hint="Dùng khi không chọn file kịch bản." Margin="0"
                         Visibility="{Binding IsTextMode, Converter={StaticResource BoolToVis}}">
                  <ui:TextBox Text="{Binding ScriptText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="84" MaxHeight="180"
                              VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" PlaceholderText="Nhập hoặc dán kịch bản/văn bản cần đọc…" />
                </c:Field>
              </StackPanel>
            </ui:Card>

            <ui:Card Style="{StaticResource Section}" Visibility="{Binding UsesVoice, Converter={StaticResource BoolToVis}}">
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="Ngôn ngữ &amp; giọng đọc" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <c:Field Header="Ngôn ngữ nguồn" Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVis}}">
                    <ComboBox ItemsSource="{Binding SourceLanguages}" SelectedItem="{Binding SourceLanguage}" DisplayMemberPath="Display" />
                  </c:Field>
                  <c:Field Grid.Column="2" Header="Ngôn ngữ đích / giọng đọc">
                    <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding TargetLanguage}" DisplayMemberPath="Display" />
                  </c:Field>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <c:Field Header="Giọng" Margin="0">
                    <ComboBox ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}" DisplayMemberPath="DisplayName" />
                  </c:Field>
                  <c:Field Grid.Column="2" Header="Tốc độ đọc" Margin="0">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueText}" Text="{Binding Speed, StringFormat={}{0:0.00}x}" />
                      <Slider Minimum="0.8" Maximum="1.5" Value="{Binding Speed}" />
                    </DockPanel>
                  </c:Field>
                </Grid>
                <ui:ToggleSwitch Content="Dịch lời thoại sang ngôn ngữ đích" IsChecked="{Binding Translate}" Margin="0,12,0,0"
                                 Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVis}}" />
              </StackPanel>
            </ui:Card>

            <ui:Card Style="{StaticResource Section}" Visibility="{Binding IsReviewMode, Converter={StaticResource BoolToVis}}">
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="Review / tóm tắt" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <c:Field Header="Độ dài video (giây)">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueText}" Text="{Binding TargetSeconds}" MinWidth="36" />
                      <Slider Minimum="5" Maximum="600" Value="{Binding TargetSeconds}" />
                    </DockPanel>
                  </c:Field>
                  <c:Field Grid.Column="2" Header="Phong cách">
                    <ui:TextBox Text="{Binding Style, UpdateSourceTrigger=PropertyChanged}" />
                  </c:Field>
                </Grid>
                <c:LlmPicker DataContext="{Binding ScriptAi}" />
                <WrapPanel>
                  <ui:ToggleSwitch Content="AI chọn cảnh &amp; viết lời bình" IsChecked="{Binding UseAi}" Margin="0,0,24,0" />
                  <ui:ToggleSwitch Content="Đọc lời bình" IsChecked="{Binding Narration}" />
                </WrapPanel>
              </StackPanel>
            </ui:Card>

            <ui:Card Style="{StaticResource Section}" Visibility="{Binding IsScriptMode, Converter={StaticResource BoolToVis}}">
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="Hình nền cho kịch bản" />
                <c:Field Header="Video nền có sẵn" Hint="Ưu tiên hơn ảnh slide. Video được lặp cho đủ thời lượng giọng đọc (vd video xuất từ ArtCraft).">
                  <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Bỏ video nền" Command="{Binding ClearFileCommand}" CommandParameter="background" />
                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Chọn video nền…" Command="{Binding PickCommand}" CommandParameter="background" />
                    <ui:TextBox Text="{Binding BackgroundVideo}" c:FileDrop.IsEnabled="True" />
                  </DockPanel>
                </c:Field>
                <c:Field Header="Ảnh slide" Hint="Dùng khi không chọn video nền; trống = nền tối mặc định." Margin="0">
                  <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Bỏ ảnh" Command="{Binding ClearFileCommand}" CommandParameter="slide" />
                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Chọn ảnh…" Command="{Binding PickCommand}" CommandParameter="slide" />
                    <ui:TextBox Text="{Binding SlidePath}" c:FileDrop.IsEnabled="True" />
                  </DockPanel>
                </c:Field>
              </StackPanel>
            </ui:Card>

            <ui:Card Style="{StaticResource Section}" Visibility="{Binding IsAudioMode, Converter={StaticResource BoolToVis}}">
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="Xử lý audio" />
                <c:Field Header="Thao tác" Margin="0">
                  <ComboBox ItemsSource="{x:Static local:AutoWorkflowViewModel.Operations}" SelectedItem="{Binding Operation}" HorizontalAlignment="Left" MinWidth="200" />
                </c:Field>
              </StackPanel>
            </ui:Card>

            <ui:Card Style="{StaticResource Section}" Visibility="{Binding UsesVideoOutput, Converter={StaticResource BoolToVis}}">
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="Video đầu ra" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <c:Field Header="Tỉ lệ khung">
                    <ComboBox ItemTemplate="{StaticResource LabelItem}" ItemsSource="{x:Static local:AutoWorkflowViewModel.Aspects}" SelectedItem="{Binding Aspect}" />
                  </c:Field>
                  <c:Field Grid.Column="2" Header="Độ phân giải">
                    <ComboBox ItemsSource="{x:Static local:AutoWorkflowViewModel.Resolutions}" SelectedItem="{Binding Resolution}" />
                  </c:Field>
                  <c:Field Grid.Column="4" Header="Cách lấp khung">
                    <ComboBox ItemTemplate="{StaticResource LabelItem}" ItemsSource="{x:Static local:AutoWorkflowViewModel.Fits}" SelectedItem="{Binding Fit}" />
                  </c:Field>
                </Grid>
                <ui:ToggleSwitch Content="Hiện phụ đề" IsChecked="{Binding Captions}" Margin="0,0,0,12" />
                <c:Field Header="Âm lượng tiếng gốc">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueText}" Text="{Binding Volume, StringFormat={}{0:P0}}" />
                    <Slider Minimum="0" Maximum="1" Value="{Binding Volume}" />
                  </DockPanel>
                </c:Field>
                <c:Field Header="Nhạc nền" Margin="0">
                  <StackPanel>
                    <DockPanel>
                      <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Bỏ nhạc nền" Command="{Binding ClearFileCommand}" CommandParameter="music" />
                      <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Chọn nhạc nền…" Command="{Binding PickCommand}" CommandParameter="music" />
                      <ui:TextBox Text="{Binding MusicPath}" c:FileDrop.IsEnabled="True" />
                    </DockPanel>
                    <DockPanel Margin="0,8,0,0">
                      <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueText}" Text="{Binding MusicVolume, StringFormat={}{0:P0}}" />
                      <Slider Minimum="0" Maximum="1" Value="{Binding MusicVolume}" />
                    </DockPanel>
                  </StackPanel>
                </c:Field>
              </StackPanel>
            </ui:Card>

            <ui:CardExpander Style="{StaticResource Advanced}" Header="Đăng bài sau khi xong" Icon="{ui:SymbolIcon Send24}" Visibility="{Binding CanDeliver, Converter={StaticResource BoolToVis}}">
              <StackPanel>
                <ui:ToggleSwitch Content="Xếp video vào lịch đăng" IsChecked="{Binding DeliverEnabled}" Margin="0,0,0,12" />
                <c:Field Header="Kênh đích" Hint="Kết nối tài khoản và đồng bộ kênh ở S23. Kênh ghi &quot;chưa đăng được&quot; cần xử lý trước (di chuột để xem lý do).">
                  <c:DestinationPicker DataContext="{Binding Destinations}" />
                </c:Field>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <c:Field Header="Chế độ" Hint="review: bạn duyệt từng bài; automatic: tự đăng đúng giờ">
                    <ComboBox ItemsSource="{x:Static local:AutoWorkflowViewModel.DeliveryModesList}" SelectedItem="{Binding DeliveryMode}" />
                  </c:Field>
                  <c:Field Grid.Column="2" Header="Quyền riêng tư">
                    <ComboBox ItemTemplate="{StaticResource LabelItem}" ItemsSource="{x:Static local:AutoWorkflowViewModel.Privacies}" SelectedItem="{Binding Privacy}" />
                  </c:Field>
                </Grid>
                <c:Field Header="Tiêu đề (trống = tên video)">
                  <ui:TextBox Text="{Binding DeliveryTitle, UpdateSourceTrigger=PropertyChanged}" />
                </c:Field>
                <c:Field Header="Mô tả">
                  <ui:TextBox Text="{Binding DeliveryCaption, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" VerticalContentAlignment="Top" />
                </c:Field>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <c:Field Header="Chờ trước khi đăng (phút)" Margin="0">
                    <ui:TextBox Text="{Binding DelayMinutes}" />
                  </c:Field>
                  <c:Field Grid.Column="2" Header="Cách nhau (phút)" Margin="0">
                    <ui:TextBox Text="{Binding SpacingMinutes}" />
                  </c:Field>
                  <c:Field Grid.Column="4" Header="Tối đa mỗi ngày" Margin="0">
                    <ui:TextBox Text="{Binding DailyLimit}" />
                  </c:Field>
                </Grid>
              </StackPanel>
            </ui:CardExpander>

            <TextBlock Style="{StaticResource Hint}" Text="{Binding Status}" Visibility="{Binding Status, Converter={StaticResource NotEmptyToVis}}" />
          </StackPanel>
        </ScrollViewer>
      </c:SplitView.Primary>

      <c:SplitView.Secondary>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="1.5*" MinHeight="160" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" MinHeight="120" />
          </Grid.RowDefinitions>
          <ui:Card Style="{StaticResource FillSection}" Margin="0">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock Style="{StaticResource CardTitle}" Text="Tác vụ Auto" Margin="0" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Mở thư mục chứa kết quả" Command="{Binding OpenOutputCommand}" />
                  <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="Chạy lại tác vụ (tiếp từ bước lỗi)" Command="{Binding RetryJobCommand}" />
                  <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Huỷ tác vụ" Command="{Binding CancelJobCommand}" />
                </StackPanel>
              </DockPanel>
              <Grid>
                <DataGrid ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          CanUserAddRows="False" HeadersVisibility="Column">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Tác vụ" Binding="{Binding Title}" Width="*" />
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="110" />
                    <DataGridTextColumn Header="Tiến độ" Binding="{Binding Progress}" Width="70" />
                    <DataGridTextColumn Header="Ghi chú" Binding="{Binding Detail}" Width="*" />
                  </DataGrid.Columns>
                </DataGrid>
                <c:EmptyState Icon="Flowchart24" Text="Chưa có tác vụ nào. Chọn chế độ, thêm nguồn rồi bấm Chạy tự động."
                              Visibility="{Binding Jobs.Count, Converter={StaticResource EmptyToVis}}" IsHitTestVisible="False" />
              </Grid>
            </DockPanel>
          </ui:Card>
          <ui:Card Grid.Row="2" Style="{StaticResource FillSection}" Margin="0">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock Style="{StaticResource CardTitle}" Text="Bài đăng của tác vụ" Margin="0" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <ui:Button Content="Duyệt" Icon="{ui:SymbolIcon Checkmark24}" Command="{Binding ApproveCommand}" />
                  <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Huỷ bài đăng đang chọn" Command="{Binding CancelPostCommand}" />
                </StackPanel>
              </DockPanel>
              <Grid>
                <DataGrid ItemsSource="{Binding Deliveries}" SelectedItem="{Binding SelectedDelivery}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          CanUserAddRows="False" HeadersVisibility="Column">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Kênh" Binding="{Binding Account}" Width="*" />
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="110" />
                    <DataGridTextColumn Header="Giờ đăng" Binding="{Binding Due}" Width="130" />
                  </DataGrid.Columns>
                </DataGrid>
                <c:EmptyState Icon="Send24" Text="Tác vụ chưa có bài đăng. Bật &quot;Đăng bài sau khi xong&quot; ở cột trái để xếp video vào lịch."
                              Visibility="{Binding Deliveries.Count, Converter={StaticResource EmptyToVis}}" IsHitTestVisible="False" />
              </Grid>
            </DockPanel>
          </ui:Card>
        </Grid>
      </c:SplitView.Secondary>
    </c:SplitView>
  </DockPanel>
</UserControl>
