<UserControl x:Class="SuperMOOO.App.Features.S15.JobsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:SuperMOOO.App.Controls">
  <DockPanel Margin="{StaticResource PagePadding}">
    <c:ScreenHeader DockPanel.Dock="Top" Title="Tác vụ (Jobs)"
                    Description="Mọi việc chạy nền (tải, lồng tiếng, xuất video, đăng bài…) hiện ở đây; huỷ hoặc chạy lại khi cần." />

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="2*" MinHeight="200" />
        <RowDefinition Height="12" />
        <RowDefinition Height="*" MinHeight="140" />
      </Grid.RowDefinitions>

      <ui:Card Style="{StaticResource FillSection}" Margin="0">
        <DockPanel>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Trạng thái" VerticalAlignment="Center" Margin="0,0,8,8" />
            <ComboBox ItemTemplate="{StaticResource LabelItem}" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" Width="180" Margin="0,0,16,8" />
            <ui:Button Content="Huỷ" Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding CancelCommand}" Margin="0,0,8,8" ToolTip="Huỷ tác vụ đang chọn" />
            <ui:Button Content="Thử lại từ bước lỗi" Icon="{ui:SymbolIcon ArrowRepeatAll24}" Command="{Binding RetryCommand}" Margin="0,0,8,8" />
            <ui:Button Content="Thử lại từ đầu" Icon="{ui:SymbolIcon ArrowReset24}" Command="{Binding RetryFromStartCommand}" Margin="0,0,8,8" />
            <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="Làm mới" Command="{Binding RefreshCommand}" Margin="0,0,0,8" />
          </WrapPanel>
          <Grid>
            <DataGrid ItemsSource="{Binding Jobs}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" CanUserAddRows="False" HeadersVisibility="Column">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Tác vụ" Binding="{Binding Title}" Width="2*" />
                <DataGridTextColumn Header="Loại" Binding="{Binding Type}" Width="*" />
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="*" />
                <DataGridTemplateColumn Header="Tiến độ" Width="*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <DockPanel Margin="4,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressPercent, StringFormat={}{0}%}" Width="40" TextAlignment="Right"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" VerticalAlignment="Center" />
                      </DockPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Thông báo / lỗi" Binding="{Binding Summary}" Width="3*" />
                <DataGridTextColumn Header="Tạo lúc" Binding="{Binding Created}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
            <c:EmptyState Icon="TaskListLtr24" Text="Không có tác vụ nào ở trạng thái này."
                          Visibility="{Binding Jobs.Count, Converter={StaticResource EmptyToVis}}" />
          </Grid>
        </DockPanel>
      </ui:Card>

      <ui:Card Grid.Row="2" Style="{StaticResource FillSection}" Margin="0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="Chi tiết tác vụ đang chọn" />
          <ui:TextBox Text="{Binding Detail, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                      VerticalScrollBarVisibility="Auto" PlaceholderText="Chọn một tác vụ để xem các bước, thông báo và lỗi." />
        </DockPanel>
      </ui:Card>
    </Grid>
  </DockPanel>
</UserControl>
