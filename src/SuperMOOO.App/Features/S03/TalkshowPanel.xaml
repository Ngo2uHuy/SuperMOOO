<UserControl x:Class="SuperMOOO.App.Features.S03.TalkshowPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:SuperMOOO.App.Controls"
             xmlns:local="clr-namespace:SuperMOOO.App.Features.S03">
  <c:SplitView PrimaryRatio="1.05">
    <c:SplitView.Primary>
      <DockPanel>
        <c:JobStatusBar DockPanel.Dock="Bottom" Margin="0,12,16,0" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,0,16,0">
            <ui:Card Style="{StaticResource Section}">
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="Kịch bản talkshow" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="200" />
                  </Grid.ColumnDefinitions>
                  <c:Field Header="Chủ đề">
                    <ComboBox ItemsSource="{Binding Topics}" SelectedItem="{Binding Topic}" />
                  </c:Field>
                  <c:Field Grid.Column="2" Header="Thời lượng kịch bản (phút)" ToolTip="Thời lượng AI viết, 1–90 phút">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueText}" Text="{Binding Minutes}" MinWidth="28" />
                      <Slider Minimum="1" Maximum="90" Value="{Binding Minutes}" VerticalAlignment="Center" />
                    </DockPanel>
                  </c:Field>
                </Grid>
                <c:Field Header="Yêu cầu thêm cho AI" Hint="Chọn &quot;Chủ đề tự nhập&quot; thì ô này là bắt buộc.">
                  <ui:TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ví dụ: câu chuyện người con xa quê nhớ mẹ" />
                </c:Field>
                <c:LlmPicker DataContext="{Binding ScriptAi}" />
                <WrapPanel Margin="0,0,0,12">
                  <ui:Button Style="{StaticResource ToolButton}" Content="AI viết kịch bản" Icon="{ui:SymbolIcon Sparkle24}" Command="{Binding GenerateScriptCommand}" />
                  <ui:Button Style="{StaticResource ToolButton}" Content="Nạp kịch bản mẫu" Icon="{ui:SymbolIcon DocumentText24}" Command="{Binding LoadDemoCommand}"
                             ToolTip="Kịch bản viết sẵn, dùng được khi chưa có API key" />
                </WrapPanel>
                <c:Field Header="Lời thoại" Hint="Mỗi đoạn bắt đầu bằng MC: hoặc KHÁCH: — sửa tự do trước khi xuất." Margin="0">
                  <ui:TextBox Text="{Binding ScriptText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="180" MaxHeight="320"
                              VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" PlaceholderText="MC: Chào bạn…&#x0a;&#x0a;KHÁCH: Xin chào…" />
                </c:Field>
              </StackPanel>
            </ui:Card>

            <ui:Card Style="{StaticResource Section}">
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="Hai giọng đọc" />
                <c:Field Header="Ngôn ngữ">
                  <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" DisplayMemberPath="Display" HorizontalAlignment="Left" MinWidth="240" />
                </c:Field>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <c:Field Header="Giọng MC">
                    <StackPanel>
                      <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Speaker224}" ToolTip="Nghe thử giọng MC" Command="{Binding PreviewVoiceCommand}" CommandParameter="host" />
                        <ComboBox ItemsSource="{Binding Voices}" SelectedItem="{Binding HostVoice}" DisplayMemberPath="DisplayName" />
                      </DockPanel>
                      <DockPanel Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueText}" Text="{Binding HostSpeed, StringFormat={}{0:0.00}x}" />
                        <Slider Minimum="0.7" Maximum="1.4" Value="{Binding HostSpeed}" />
                      </DockPanel>
                    </StackPanel>
                  </c:Field>
                  <c:Field Grid.Column="2" Header="Giọng khách mời">
                    <StackPanel>
                      <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Speaker224}" ToolTip="Nghe thử giọng khách" Command="{Binding PreviewVoiceCommand}" CommandParameter="guest" />
                        <ComboBox ItemsSource="{Binding Voices}" SelectedItem="{Binding GuestVoice}" DisplayMemberPath="DisplayName" />
                      </DockPanel>
                      <DockPanel Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueText}" Text="{Binding GuestSpeed, StringFormat={}{0:0.00}x}" />
                        <Slider Minimum="0.7" Maximum="1.4" Value="{Binding GuestSpeed}" />
                      </DockPanel>
                    </StackPanel>
                  </c:Field>
                </Grid>
              </StackPanel>
            </ui:Card>

            <ui:CardExpander Style="{StaticResource Advanced}" Header="Sân khấu, nhạc nền &amp; xuất file" Icon="{ui:SymbolIcon Building24}">
              <StackPanel>
                <c:Field Header="Ảnh sân khấu (màn xanh #00FF00)" Hint="Để trống = sân khấu mẫu đi kèm app.">
                  <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Dùng sân khấu mẫu" Command="{Binding ClearFileCommand}" CommandParameter="stage" />
                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Chọn ảnh sân khấu…" Command="{Binding PickCommand}" CommandParameter="stage" />
                    <ui:TextBox Text="{Binding StagePath}" c:FileDrop.IsEnabled="True" />
                  </DockPanel>
                </c:Field>
                <c:Field Header="Phông sau màn hình" Hint="Ảnh (lia nhẹ) hoặc video (lặp). Để trống = phông mẫu.">
                  <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Dùng phông mẫu" Command="{Binding ClearFileCommand}" CommandParameter="scenery" />
                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Chọn phông…" Command="{Binding PickCommand}" CommandParameter="scenery" />
                    <ui:TextBox Text="{Binding SceneryPath}" c:FileDrop.IsEnabled="True" />
                  </DockPanel>
                </c:Field>
                <c:Field Header="Nhạc nền">
                  <StackPanel>
                    <DockPanel>
                      <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Bỏ nhạc nền" Command="{Binding ClearFileCommand}" CommandParameter="music" />
                      <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Chọn nhạc nền…" Command="{Binding PickCommand}" CommandParameter="music" />
                      <ui:TextBox Text="{Binding MusicPath}" c:FileDrop.IsEnabled="True" />
                    </DockPanel>
                    <DockPanel Margin="0,8,0,0">
                      <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueText}" Text="{Binding MusicVolume, StringFormat={}{0:P0}}" />
                      <Slider Minimum="0" Maximum="0.5" Value="{Binding MusicVolume}" />
                    </DockPanel>
                  </StackPanel>
                </c:Field>
                <WrapPanel Margin="0,0,0,12">
                  <ui:ToggleSwitch Content="Phụ đề" IsChecked="{Binding Captions}" Margin="0,0,24,0" />
                  <ui:ToggleSwitch Content="Key màn xanh" IsChecked="{Binding ScreenKey}" Margin="0,0,24,0" />
                  <TextBlock Text="Độ phân giải" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <ComboBox ItemsSource="{x:Static local:TalkshowViewModel.Heights}" SelectedItem="{Binding Height}" Width="90" />
                </WrapPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <c:Field Header="Tên chương trình" Margin="0">
                    <ui:TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                  </c:Field>
                  <c:Field Grid.Column="2" Header="Thư mục xuất" Hint="Trống = Videos\SuperMOOO\Talkshow" Margin="0">
                    <DockPanel>
                      <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Chọn thư mục xuất…" Command="{Binding ChooseOutputFolderCommand}" />
                      <ui:TextBox Text="{Binding OutputFolder}" c:FileDrop.IsEnabled="True" />
                    </DockPanel>
                  </c:Field>
                </Grid>
              </StackPanel>
            </ui:CardExpander>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </c:SplitView.Primary>

    <c:SplitView.Secondary>
      <DockPanel>
        <ui:Card DockPanel.Dock="Bottom" Style="{StaticResource Section}" Margin="0,12,0,0">
          <StackPanel>
            <WrapPanel>
              <ui:Button Content="Xem trước sân khấu" Icon="{ui:SymbolIcon Image24}" Command="{Binding PreviewStageCommand}" Margin="0,0,8,8" />
              <ui:Button Content="Mở video" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenOutputCommand}" Margin="0,0,8,8" />
              <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Mở thư mục chứa video" Command="{Binding OpenOutputFolderCommand}" Margin="0,0,0,8" />
            </WrapPanel>
            <TextBlock Style="{StaticResource Hint}" Text="{Binding Status}" />
          </StackPanel>
        </ui:Card>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="12" />
            <RowDefinition Height="1.3*" MinHeight="160" />
          </Grid.RowDefinitions>
          <Border CornerRadius="{StaticResource Radius}" Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
              <c:EmptyState x:Name="FrameEmpty" Icon="Image24" Text="Bấm Xem trước sân khấu để xem phông và màn xanh ghép thế nào." />
              <Image x:Name="Frame" Stretch="Uniform" Margin="4" />
            </Grid>
          </Border>
          <ContentControl x:Name="ClipHost" Grid.Row="2" Focusable="False" />
        </Grid>
      </DockPanel>
    </c:SplitView.Secondary>
  </c:SplitView>
</UserControl>
