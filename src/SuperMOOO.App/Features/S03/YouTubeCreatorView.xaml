<UserControl x:Class="SuperMOOO.App.Features.S03.YouTubeCreatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:SuperMOOO.App.Controls"
             xmlns:local="clr-namespace:SuperMOOO.App.Features.S03">
  <DockPanel Margin="{StaticResource PagePadding}">
    <c:ScreenHeader DockPanel.Dock="Top" Title="Video YouTube &amp; Talkshow"
                    Description="Biến kịch bản thành video YouTube có giọng đọc, hoặc dựng talkshow hai giọng trên sân khấu.">
      <ui:Button x:Name="RunButton" Appearance="Primary" Content="Dựng video YouTube" Icon="{ui:SymbolIcon Play24}" Click="OnRun" />
    </c:ScreenHeader>

    <c:ScreenJobsPanel x:Name="ScreenJobs" DockPanel.Dock="Bottom" Margin="0,12,0,0" />
    <TabControl x:Name="Tabs" SelectionChanged="OnTabChanged">
      <TabItem Header="Video YouTube">
        <c:SplitView PrimaryRatio="1.05" Margin="0,12,0,0" DataContext="{Binding YouTube}">
          <c:SplitView.Primary>
            <DockPanel>
              <c:JobStatusBar DockPanel.Dock="Bottom" Margin="0,12,16,0" />
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,16,0">
                  <ui:Card Style="{StaticResource Section}">
                    <StackPanel>
                      <DockPanel Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource CardTitle}" Text="Kịch bản" Margin="0" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                          <ui:Button Content="Chọn thư mục" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding BrowseScriptFolderCommand}" />
                          <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon DocumentAdd24}" ToolTip="Nhập một file kịch bản (.txt, .docx)" Command="{Binding AddScriptFileCommand}" />
                          <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon ArrowSync24}" ToolTip="Quét lại thư mục" Command="{Binding ScanScriptsCommand}" />
                          <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon CheckboxChecked24}" ToolTip="Chọn / bỏ chọn tất cả" Command="{Binding ToggleAllScriptsCommand}" />
                        </StackPanel>
                      </DockPanel>
                      <Grid Height="150">
                        <ListBox ItemsSource="{Binding Scripts}">
                          <ListBox.ItemTemplate>
                            <DataTemplate>
                              <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" Text="{Binding Detail}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Name}" />
                              </DockPanel>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                        <c:EmptyState Icon="DocumentText24" Text="Chọn thư mục hoặc nhập file kịch bản (.txt, .docx), hoặc dán ở dưới."
                                      Visibility="{Binding Scripts.Count, Converter={StaticResource EmptyToVis}}" IsHitTestVisible="False" />
                      </Grid>
                      <c:Field Header="Hoặc dán kịch bản" Margin="0,12,0,0" Hint="Mỗi kịch bản ra một video; tên video lấy từ ô tên.">
                        <StackPanel>
                          <ui:TextBox Text="{Binding PastedName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Tên video (tuỳ chọn)" Margin="0,0,0,8" />
                          <ui:TextBox Text="{Binding PastedText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="160"
                                      VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" PlaceholderText="Nhập hoặc dán nội dung kịch bản…" />
                        </StackPanel>
                      </c:Field>
                    </StackPanel>
                  </ui:Card>

                  <ui:Card Style="{StaticResource Section}">
                    <StackPanel>
                      <DockPanel Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource CardTitle}" Text="Slide nền" Margin="0" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                          <ui:Button Content="Chọn thư mục" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding BrowseSlideFolderCommand}" />
                          <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Add24}" ToolTip="Thêm một ảnh hoặc clip" Command="{Binding AddSlideCommand}" />
                          <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Delete24}" ToolTip="Xoá hết slide" Command="{Binding ClearSlidesCommand}" />
                        </StackPanel>
                      </DockPanel>
                      <Grid Height="120" AllowDrop="True" Drop="OnSlidesDrop">
                        <ListBox ItemsSource="{Binding Slides}" />
                        <c:EmptyState Icon="Image24" Text="Chưa có slide: dùng nền tối mặc định. Kéo thả ảnh/clip vào đây."
                                      Visibility="{Binding Slides.Count, Converter={StaticResource EmptyToVis}}" IsHitTestVisible="False" />
                      </Grid>
                      <c:Field Header="Thứ tự dùng slide" Margin="0,12,0,0">
                        <ComboBox ItemsSource="{x:Static local:YouTubeCreatorViewModel.SlideOrders}" SelectedItem="{Binding SelectedSlideOrder}" DisplayMemberPath="Name"
                                  HorizontalAlignment="Left" MinWidth="220" />
                      </c:Field>
                    </StackPanel>
                  </ui:Card>

                  <ui:Card Style="{StaticResource Section}">
                    <StackPanel>
                      <TextBlock Style="{StaticResource CardTitle}" Text="Giọng đọc" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="12" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <c:Field Header="Ngôn ngữ">
                          <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" DisplayMemberPath="Display" />
                        </c:Field>
                        <c:Field Grid.Column="2" Header="Giọng">
                          <ComboBox ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}" DisplayMemberPath="DisplayName" />
                        </c:Field>
                      </Grid>
                      <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Content="Nghe thử" Icon="{ui:SymbolIcon Speaker224}" Command="{Binding PreviewVoiceCommand}" Margin="12,0,0,0" />
                        <TextBlock DockPanel.Dock="Left" Text="Tốc độ" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueText}" Text="{Binding Speed, StringFormat={}{0:0.00}x}" />
                        <Slider Minimum="0.8" Maximum="1.5" Value="{Binding Speed}" VerticalAlignment="Center" />
                      </DockPanel>
                    </StackPanel>
                  </ui:Card>

                  <ui:CardExpander Style="{StaticResource Advanced}" Header="Hình ảnh &amp; xuất file" Icon="{ui:SymbolIcon VideoClip24}">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="12" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <c:Field Header="Độ phân giải (chiều cao)">
                          <ComboBox ItemsSource="{x:Static local:YouTubeCreatorViewModel.Heights}" SelectedItem="{Binding Height}" />
                        </c:Field>
                        <c:Field Grid.Column="2" Header="Màu sóng âm">
                          <ComboBox ItemsSource="{x:Static local:YouTubeCreatorViewModel.WaveColors}" SelectedItem="{Binding SelectedWaveColor}" DisplayMemberPath="Name" />
                        </c:Field>
                      </Grid>
                      <WrapPanel Margin="0,0,0,12">
                        <ui:ToggleSwitch Content="Zoom Ken Burns" IsChecked="{Binding KenBurns}" Margin="0,0,24,0" />
                        <ui:ToggleSwitch Content="Mờ dần vào/ra" IsChecked="{Binding Fade}" Margin="0,0,24,0" />
                        <ui:ToggleSwitch Content="Sóng âm" IsChecked="{Binding Waveform}" />
                      </WrapPanel>
                      <c:Field Header="Intro" Hint="Tuỳ chọn: video ghép vào đầu mỗi video.">
                        <DockPanel>
                          <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Chọn video intro…" Command="{Binding PickCommand}" CommandParameter="intro" />
                          <ui:TextBox Text="{Binding IntroPath}" c:FileDrop.IsEnabled="True" />
                        </DockPanel>
                      </c:Field>
                      <c:Field Header="Outro" Hint="Tuỳ chọn: video ghép vào cuối mỗi video.">
                        <DockPanel>
                          <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Chọn video outro…" Command="{Binding PickCommand}" CommandParameter="outro" />
                          <ui:TextBox Text="{Binding OutroPath}" c:FileDrop.IsEnabled="True" />
                        </DockPanel>
                      </c:Field>
                      <c:Field Header="Thư mục xuất" Hint="Để trống = Videos\SuperMOOO\YouTube" Margin="0">
                        <DockPanel>
                          <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Chọn thư mục xuất…" Command="{Binding ChooseOutputFolderCommand}" />
                          <ui:TextBox Text="{Binding OutputFolder}" c:FileDrop.IsEnabled="True" />
                        </DockPanel>
                      </c:Field>
                    </StackPanel>
                  </ui:CardExpander>
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </c:SplitView.Primary>

          <c:SplitView.Secondary>
            <DockPanel>
              <ui:Card DockPanel.Dock="Bottom" Style="{StaticResource Section}" Margin="0,12,0,0">
                <StackPanel>
                  <WrapPanel>
                    <ui:Button Content="Mở video" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenOutputCommand}" Margin="0,0,8,8" />
                    <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Mở thư mục chứa video" Command="{Binding OpenOutputFolderCommand}" Margin="0,0,0,8" />
                  </WrapPanel>
                  <TextBlock Style="{StaticResource Hint}" Text="{Binding Status}" />
                  <Expander Header="Nhật ký" Margin="0,8,0,0">
                    <ListBox ItemsSource="{Binding Log}" Height="90" FontSize="12" />
                  </Expander>
                </StackPanel>
              </ui:Card>
              <ContentControl x:Name="ClipHost" Focusable="False" />
            </DockPanel>
          </c:SplitView.Secondary>
        </c:SplitView>
      </TabItem>

      <TabItem Header="Talkshow">
        <local:TalkshowPanel x:Name="Talk" Margin="0,12,0,0" DataContext="{Binding Talkshow}" />
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
