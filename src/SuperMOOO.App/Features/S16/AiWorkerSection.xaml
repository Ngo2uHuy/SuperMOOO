<UserControl x:Class="SuperMOOO.App.Features.S16.AiWorkerSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SuperMOOO.App.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,16,0">
      <ui:InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Thiết lập tự động" Margin="{StaticResource CardGap}"
                  Message="Lần mở đầu sau khi cài, app tự tải Python, thư viện, model nhận diện, dịch, các giọng TTS và MuseTalk. Cần Internet và nhiều chục GB trống. Gỡ app sẽ dọn thành phần do app cài; dự án, video và giọng người dùng được giữ lại." />
      <ui:Card Style="{StaticResource Section}">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="Trạng thái" />
          <TextBlock Text="{Binding PythonStatus}" TextWrapping="Wrap" />
          <WrapPanel Margin="0,12,0,0">
            <ui:Button Appearance="Primary" Content="Cài đầy đủ thành phần" Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding InstallWorkerCommand}" Margin="0,0,8,8" />
            <ui:Button Content="Kiểm tra khả năng" Icon="{ui:SymbolIcon CheckmarkCircle24}" Command="{Binding CheckCapabilitiesCommand}" Margin="0,0,8,8" />
            <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="Làm mới trạng thái" Command="{Binding RefreshStatusCommand}" Margin="0,0,0,8" />
          </WrapPanel>
          <TextBlock Style="{StaticResource Hint}" Text="{Binding Status}" />
          <ItemsControl ItemsSource="{Binding Capabilities}" Margin="0,8,0,0" />
        </StackPanel>
      </ui:Card>
      <c:ScreenJobsPanel x:Name="ScreenJobs" Margin="0,12,0,12" />
      <ui:CardExpander Style="{StaticResource Advanced}" Header="Nhật ký cài đặt" Icon="{ui:SymbolIcon DocumentText24}">
        <ui:TextBox Text="{Binding Log, Mode=OneWay}" IsReadOnly="True" Height="220" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                    TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" />
      </ui:CardExpander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
