<UserControl x:Class="SuperMOOO.App.Features.S16.LiveLlmSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:SuperMOOO.App.Controls">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Padding="0,12,0,0">
      <StackPanel Orientation="Horizontal">
        <ui:Button Appearance="Primary" Content="Lưu" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveCommand}" />
        <ui:Button Content="Kiểm tra model local" Icon="{ui:SymbolIcon PlugConnected24}" Command="{Binding CheckCommand}" Margin="8,0,0,0" />
        <TextBlock Style="{StaticResource Hint}" Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,0,0" />
      </StackPanel>
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,16,0">
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                   Text="Model trả lời bình luận và gợi ý lời thoại cho Livestream bán hàng (S20). Model local chỉ chạy một suy luận mỗi lúc, tự tắt khi rảnh hoặc khi máy thiếu RAM." />
        <ui:Card Style="{StaticResource Section}">
          <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="Model local" />
            <c:Field Header="Nguồn model local">
              <ComboBox ItemTemplate="{StaticResource LabelItem}" ItemsSource="{Binding LocalProviders}" SelectedItem="{Binding LocalProvider}" />
            </c:Field>
            <StackPanel Visibility="{Binding IsBundled, Converter={StaticResource BoolToVis}}">
              <TextBlock Style="{StaticResource Hint}" Text="{Binding ModelState}" TextWrapping="Wrap" Margin="0,0,0,8" />
              <ui:Button Content="Tải model Qwen3 1.7B (khoảng 1,1 GB)" Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding DownloadCommand}" Margin="0,0,0,12" />
              <TextBox Text="{Binding Log, Mode=OneWay}" IsReadOnly="True" Height="90" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                       Visibility="{Binding Log, Converter={StaticResource NotEmptyToVis}}" Margin="0,0,0,12" />
            </StackPanel>
            <c:Field Header="Model Ollama / LM Studio" Hint="URL máy chủ đặt ở mục Model AI → Máy chủ cục bộ."
                     Visibility="{Binding IsOllama, Converter={StaticResource BoolToVis}}">
              <ui:TextBox Text="{Binding LocalModel, UpdateSourceTrigger=PropertyChanged}" />
            </c:Field>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <c:Field Header="Ngữ cảnh (token)" Hint="1024–16384; mặc định 4096." Margin="0,0,8,0">
                <ui:TextBox Text="{Binding NumCtx}" />
              </c:Field>
              <c:Field Grid.Column="1" Header="Dùng lại câu trả lời trong (giây)" Hint="0 = tắt; mặc định 300." Margin="0">
                <ui:TextBox Text="{Binding ReplyCacheSeconds}" />
              </c:Field>
            </Grid>
          </StackPanel>
        </ui:Card>
        <ui:Card Style="{StaticResource Section}">
          <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="Model đám mây (khi chọn nguồn đám mây ở S20)" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,-6,0,12"
                       Text="Chỉ khi chọn nguồn đám mây, bình luận và đoạn thông tin liên quan mới được gửi tới nhà cung cấp. Key nhập ở mục API key." />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <c:Field Header="Nhà cung cấp" Margin="0,0,8,0">
                <ComboBox ItemTemplate="{StaticResource LabelItem}" ItemsSource="{Binding CloudProviders}" SelectedItem="{Binding CloudProvider}" />
              </c:Field>
              <c:Field Grid.Column="1" Header="Model" Hint="Để trống = model mặc định của nhà cung cấp." Margin="0">
                <ui:TextBox Text="{Binding CloudModel, UpdateSourceTrigger=PropertyChanged}" />
              </c:Field>
            </Grid>
          </StackPanel>
        </ui:Card>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
