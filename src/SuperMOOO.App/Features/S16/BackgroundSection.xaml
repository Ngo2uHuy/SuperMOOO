<UserControl x:Class="SuperMOOO.App.Features.S16.BackgroundSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,16,0">
      <ui:Card Style="{StaticResource Section}">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="Chạy nền" />
          <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,-6,0,12"
                     Text="Chạy nền giúp lịch đăng bài vẫn chạy khi bạn đóng cửa sổ. Icon ở khay hệ thống có menu Mở / Tạm dừng đăng tự động / Thoát." />
          <ui:ToggleSwitch Content="Đóng cửa sổ thì chạy nền (ẩn xuống khay, không thoát)" IsChecked="{Binding RunInBackground}" Margin="0,0,0,12" />
          <ui:ToggleSwitch Content="Khởi động cùng Windows (chỉ hiện icon khay, không mở cửa sổ và không bật server AI)" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,12" />
          <ui:ToggleSwitch Content="Tạm dừng đăng tự động (bài hẹn giờ và chiến dịch không được xếp đăng)" IsChecked="{Binding AutomationPaused}" />
        </StackPanel>
      </ui:Card>
    </StackPanel>
  </ScrollViewer>
</UserControl>
