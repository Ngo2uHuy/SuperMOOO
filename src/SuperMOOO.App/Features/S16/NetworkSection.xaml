<UserControl x:Class="SuperMOOO.App.Features.S16.NetworkSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:SuperMOOO.App.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,16,0">
      <ui:Card Style="{StaticResource Section}">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="Kết nối hiện tại" />
          <TextBlock Text="{Binding Route}" TextWrapping="Wrap" />
          <WrapPanel Margin="0,12,0,0">
            <ui:Button Content="Kiểm tra IP thật" Icon="{ui:SymbolIcon Globe24}" Command="{Binding VerifyCommand}" Margin="0,0,8,0" />
            <ui:Button Content="Ngắt (kết nối trực tiếp)" Icon="{ui:SymbolIcon PlugDisconnected24}" Command="{Binding DisconnectCommand}" />
            <TextBlock Style="{StaticResource Hint}" Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,0,0" />
          </WrapPanel>
        </StackPanel>
      </ui:Card>

      <ui:Card Style="{StaticResource Section}">
        <StackPanel>
          <DockPanel Margin="0,0,0,8">
            <TextBlock Style="{StaticResource CardTitle}" Text="Hồ sơ proxy" Margin="0" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <ui:Button Appearance="Primary" Content="Áp dụng" Icon="{ui:SymbolIcon PlugConnected24}" Command="{Binding ConnectCommand}" />
              <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Star24}" ToolTip="Đánh dấu / bỏ yêu thích" Command="{Binding ToggleFavoriteCommand}" />
              <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Delete24}" ToolTip="Xoá hồ sơ đang chọn" Command="{Binding DeleteCommand}" />
            </StackPanel>
          </DockPanel>
          <Grid Height="160">
            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Display" />
            <c:EmptyState Icon="Server24" Text="Chưa có hồ sơ proxy." Visibility="{Binding Profiles.Count, Converter={StaticResource EmptyToVis}}" />
          </Grid>
        </StackPanel>
      </ui:Card>

      <ui:Card Style="{StaticResource Section}">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="Thêm hồ sơ" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.2*" />
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="1.5*" />
              <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition />
              <RowDefinition />
            </Grid.RowDefinitions>
            <c:Field Header="Tên (tuỳ chọn)" Margin="0,0,8,12">
              <ui:TextBox Text="{Binding NewName}" />
            </c:Field>
            <c:Field Grid.Column="1" Header="Giao thức" Margin="0,0,8,12">
              <ComboBox ItemsSource="{Binding Schemes}" SelectedItem="{Binding NewScheme}" />
            </c:Field>
            <c:Field Grid.Column="2" Header="Host" Margin="0,0,8,12">
              <ui:TextBox Text="{Binding NewHost}" PlaceholderText="1.2.3.4" />
            </c:Field>
            <c:Field Grid.Column="3" Header="Cổng" Margin="0,0,0,12">
              <ui:TextBox Text="{Binding NewPort}" PlaceholderText="1080" />
            </c:Field>
            <c:Field Grid.Row="1" Header="Tên đăng nhập (tuỳ chọn)" Margin="0,0,8,0">
              <ui:TextBox Text="{Binding NewUsername}" />
            </c:Field>
            <c:Field Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Header="Mật khẩu (tuỳ chọn)" Margin="0,0,8,0">
              <PasswordBox x:Name="PasswordBox" />
            </c:Field>
            <ui:Button Grid.Row="1" Grid.Column="3" Content="Lưu" Icon="{ui:SymbolIcon Save24}" Click="OnSaveProfile" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" />
          </Grid>
        </StackPanel>
      </ui:Card>

      <ui:CardExpander Style="{StaticResource Advanced}" Header="Nhập danh sách proxy" Icon="{ui:SymbolIcon ArrowImport24}">
        <StackPanel>
          <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                     Text="Mỗi dòng: socks5://user:pass@host:1080, hoặc CSV tên,scheme,host,port,user,password, hoặc mảng JSON." />
          <ui:TextBox Text="{Binding ImportText}" AcceptsReturn="True" Height="90" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
          <ui:Button Content="Nhập" Icon="{ui:SymbolIcon ArrowImport24}" Command="{Binding ImportCommand}" Margin="0,8,0,0" />
        </StackPanel>
      </ui:CardExpander>

      <ui:Card Style="{StaticResource Section}">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="VPN có sẵn trong Windows" />
          <StackPanel Orientation="Horizontal">
            <ComboBox ItemsSource="{Binding Vpns}" SelectedItem="{Binding SelectedVpn}" Width="260" />
            <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="Làm mới danh sách VPN" Command="{Binding RefreshVpnsCommand}" />
            <ui:Button Content="Nối VPN" Icon="{ui:SymbolIcon Shield24}" Command="{Binding ConnectVpnCommand}" Margin="8,0,0,0" />
          </StackPanel>
        </StackPanel>
      </ui:Card>
    </StackPanel>
  </ScrollViewer>
</UserControl>
