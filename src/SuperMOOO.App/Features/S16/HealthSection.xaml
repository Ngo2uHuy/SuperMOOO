<UserControl x:Class="SuperMOOO.App.Features.S16.HealthSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <DockPanel>
    <ui:Card DockPanel.Dock="Top" Style="{StaticResource Section}">
      <StackPanel>
        <TextBlock Style="{StaticResource CardTitle}" Text="Tổng quan" />
        <TextBlock Text="{Binding Stats}" TextWrapping="Wrap" />
        <WrapPanel Margin="0,12,0,0">
          <ui:Button Appearance="Primary" Content="Kiểm tra lại" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshCommand}" Margin="0,0,24,0" />
          <TextBlock Text="Dọn cache" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ComboBox ItemsSource="{Binding CacheScopes}" SelectedItem="{Binding SelectedScope}" Width="140" />
          <ui:Button Content="Dọn" Icon="{ui:SymbolIcon Delete24}" Command="{Binding ClearCacheCommand}" Margin="8,0,0,0" />
          <TextBlock Style="{StaticResource Hint}" Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,0,0" />
        </WrapPanel>
      </StackPanel>
    </ui:Card>
    <ui:Card Style="{StaticResource FillSection}" Margin="0">
      <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Mục" Binding="{Binding Name}" Width="2*" />
          <DataGridTextColumn Header="Tình trạng" Binding="{Binding State}" Width="*" />
          <DataGridTextColumn Header="Chi tiết" Binding="{Binding Detail}" Width="3*" />
        </DataGrid.Columns>
      </DataGrid>
    </ui:Card>
  </DockPanel>
</UserControl>
