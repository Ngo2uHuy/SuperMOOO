<UserControl x:Class="SuperMOOO.App.Features.S06.ReupStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:SuperMOOO.App.Controls"
             xmlns:s02="clr-namespace:SuperMOOO.App.Features.S02"
             xmlns:local="clr-namespace:SuperMOOO.App.Features.S06"
             AllowDrop="True">
  <DockPanel Margin="{StaticResource PagePadding}">
    <c:ScreenHeader DockPanel.Dock="Top" Title="Reup Studio"
                    Description="Biến đổi video (khung hình, hiệu ứng, logo, giọng đọc, phụ đề) rồi xuất một file hoặc cả danh sách.">
      <StackPanel Orientation="Horizontal">
        <ui:Button Content="Chỉnh trong Timeline" Command="{Binding EditTimelineCommand}" ToolTip="Chuyển nguồn và thành phần sang màn dựng Timeline" />
      <ui:Button Appearance="Primary" Content="Xuất video" Icon="{ui:SymbolIcon VideoClip24}" Command="{Binding ExportCommand}" />
      </StackPanel>
    </c:ScreenHeader>

    <c:SplitView PrimaryRatio="1.15">
      <c:SplitView.Primary>
        <DockPanel>
          <ui:Card DockPanel.Dock="Top" Style="{StaticResource Section}" Margin="0,0,16,12">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock Style="{StaticResource CardTitle}" Text="Video nguồn" Margin="0" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <ui:Button Content="Thêm file" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddFileCommand}" />
                  <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon FolderAdd24}" ToolTip="Thêm cả thư mục video" Command="{Binding AddFolderCommand}" />
                  <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Subtract24}" ToolTip="Bỏ video đang chọn khỏi danh sách" Command="{Binding RemoveSourceCommand}" />
                  <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon MusicNote224}" ToolTip="Tách audio của video đang chọn" Command="{Binding ExtractAudioCommand}" />
                </StackPanel>
              </DockPanel>
              <Expander DockPanel.Dock="Bottom" Header="Video đã tải (Tải video, Crawler)" IsExpanded="True" Margin="0,8,0,0">
                <DockPanel Margin="0,8,0,0">
                  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <ui:Button DockPanel.Dock="Right" Content="Thêm vào nguồn" Icon="{ui:SymbolIcon ArrowUp24}" Margin="8,0,0,0"
                               ToolTip="Thêm các video đang chọn vào danh sách nguồn (giữ Ctrl/Shift để chọn nhiều)"
                               Command="{Binding AddDownloadedCommand}" CommandParameter="{Binding SelectedItems, ElementName=DownloadedList}" />
                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="Tải lại danh sách"
                               Command="{Binding LoadDownloadedCommand}" />
                    <ui:TextBox Text="{Binding DownloadedFilter, UpdateSourceTrigger=PropertyChanged, Delay=300}" PlaceholderText="Lọc theo tên hoặc liên kết…"
                                Icon="{ui:SymbolIcon Search24}">
                      <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding LoadDownloadedCommand}" />
                      </ui:TextBox.InputBindings>
                    </ui:TextBox>
                  </DockPanel>
                  <Grid Height="140">
                    <ListBox x:Name="DownloadedList" ItemsSource="{Binding Downloaded}" SelectionMode="Extended" MouseDoubleClick="OnDownloadedDoubleClick">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <StackPanel ToolTip="{Binding Path}">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Source}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <c:EmptyState Icon="ArrowDownload24" Text="Chưa có video đã tải. Tải ở S09 hoặc đưa vào tải từ S10/S11."
                                  Visibility="{Binding Downloaded.Count, Converter={StaticResource EmptyToVis}}" IsHitTestVisible="False" />
                  </Grid>
                </DockPanel>
              </Expander>
              <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Text="{Binding InfoText}" Margin="0,6,0,0" />
              <Grid Height="96">
                <ListBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" />
                <DockPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="12,0"
                           Visibility="{Binding Sources.Count, Converter={StaticResource EmptyToVis}}">
                  <ui:SymbolIcon Symbol="VideoAdd24" FontSize="28" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,12,0" />
                  <TextBlock Text="Kéo thả video hoặc thư mục vào đây — nhiều file sẽ xuất hàng loạt." VerticalAlignment="Center" TextWrapping="Wrap"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </DockPanel>
              </Grid>
            </DockPanel>
          </ui:Card>

          <c:ScreenJobsPanel x:Name="ScreenJobs" DockPanel.Dock="Bottom" Margin="0,12,16,0" />
          <c:JobStatusBar DockPanel.Dock="Bottom" Margin="0,12,16,0" />

          <TabControl>
            <TabItem Header="Preset &amp; hình">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,12,16,0">
                  <ui:Card Style="{StaticResource Section}">
                    <StackPanel>
                      <TextBlock Style="{StaticResource CardTitle}" Text="Preset" />
                      <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Content="Áp preset" Icon="{ui:SymbolIcon Checkmark24}" Command="{Binding ApplyPresetCommand}" Margin="8,0,0,0"
                                   ToolTip="Thay toàn bộ thiết lập bằng preset đang chọn" />
                        <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name" />
                      </DockPanel>
                    </StackPanel>
                  </ui:Card>
                  <ui:Card Style="{StaticResource Section}">
                    <StackPanel>
                      <TextBlock Style="{StaticResource CardTitle}" Text="Khung hình" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="12" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <c:Field Header="Tỉ lệ">
                          <ComboBox ItemTemplate="{StaticResource LabelItem}" ItemsSource="{x:Static local:ReupStudioViewModel.Aspects}" SelectedItem="{Binding Settings.Aspect}" />
                        </c:Field>
                        <c:Field Grid.Column="2" Header="Cách lấp khung">
                          <ComboBox ItemTemplate="{StaticResource LabelItem}" ItemsSource="{x:Static local:ReupStudioViewModel.Fits}" SelectedItem="{Binding Settings.Fit}" />
                        </c:Field>
                      </Grid>
                      <ui:ToggleSwitch Content="Nền mờ 2 bên" IsChecked="{Binding Settings.BlurBackground}" Margin="0,0,0,8" />
                      <ui:ToggleSwitch Content="Lật gương" IsChecked="{Binding Settings.FlipH}" />
                    </StackPanel>
                  </ui:Card>
                  <ui:Card Style="{StaticResource Section}">
                    <StackPanel>
                      <TextBlock Style="{StaticResource CardTitle}" Text="Hiệu ứng video" />
                      <c:Field Header="Zoom (%)">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueText}" Text="{Binding Settings.Zoom, StringFormat={}{0:0}}" />
                          <Slider Minimum="100" Maximum="115" Value="{Binding Settings.Zoom}" />
                        </DockPanel>
                      </c:Field>
                      <c:Field Header="Tốc độ">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueText}" Text="{Binding Settings.Speed, StringFormat={}{0:0.00}x}" />
                          <Slider Minimum="0.5" Maximum="2" Value="{Binding Settings.Speed}" />
                        </DockPanel>
                      </c:Field>
                      <c:Field Header="Độ sáng">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueText}" Text="{Binding Settings.Brightness, StringFormat={}{0:0.00}}" />
                          <Slider Minimum="-0.3" Maximum="0.3" Value="{Binding Settings.Brightness}" />
                        </DockPanel>
                      </c:Field>
                      <c:Field Header="Tương phản">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueText}" Text="{Binding Settings.Contrast, StringFormat={}{0:0.00}}" />
                          <Slider Minimum="0.5" Maximum="1.5" Value="{Binding Settings.Contrast}" />
                        </DockPanel>
                      </c:Field>
                      <c:Field Header="Bão hoà">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueText}" Text="{Binding Settings.Saturation, StringFormat={}{0:0.00}}" />
                          <Slider Minimum="0.5" Maximum="1.5" Value="{Binding Settings.Saturation}" />
                        </DockPanel>
                      </c:Field>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="12" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <c:Field Header="Cắt từ (giây)" Margin="0">
                          <ui:TextBox Text="{Binding Settings.TrimStart}" PlaceholderText="0" />
                        </c:Field>
                        <c:Field Grid.Column="2" Header="Đến (giây)" Margin="0">
                          <ui:TextBox Text="{Binding Settings.TrimEnd}" PlaceholderText="hết video" />
                        </c:Field>
                      </Grid>
                    </StackPanel>
                  </ui:Card>
                  <ui:CardExpander Style="{StaticResource Advanced}" Header="Logo" Icon="{ui:SymbolIcon Image24}">
                    <StackPanel>
                      <c:Field Header="File logo">
                        <DockPanel>
                          <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Bỏ logo" Command="{Binding ClearFileCommand}" CommandParameter="logo" />
                          <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Chọn logo…" Command="{Binding PickCommand}" CommandParameter="logo" />
                          <ui:TextBox Text="{Binding Settings.LogoPath}" c:FileDrop.IsEnabled="True" />
                        </DockPanel>
                      </c:Field>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="110" />
                          <ColumnDefinition Width="12" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="12" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <c:Field Header="Vị trí" Margin="0">
                          <ComboBox ItemsSource="{x:Static local:ReupStudioViewModel.LogoPositions}" SelectedItem="{Binding Settings.LogoPosition}" />
                        </c:Field>
                        <c:Field Grid.Column="2" Header="Độ mờ" Margin="0">
                          <Slider Minimum="0.1" Maximum="1" Value="{Binding Settings.LogoOpacity}" />
                        </c:Field>
                        <c:Field Grid.Column="4" Header="Rộng tối đa (%)" Margin="0">
                          <Slider Minimum="5" Maximum="50" Value="{Binding Settings.LogoMaxWidth}" />
                        </c:Field>
                      </Grid>
                    </StackPanel>
                  </ui:CardExpander>
                  <ui:CardExpander Style="{StaticResource Advanced}" Header="Intro / Outro" Icon="{ui:SymbolIcon VideoClipMultiple24}">
                    <StackPanel>
                      <c:Field Header="Intro">
                        <DockPanel>
                          <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Bỏ intro" Command="{Binding ClearFileCommand}" CommandParameter="intro" />
                          <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Chọn intro…" Command="{Binding PickCommand}" CommandParameter="intro" />
                          <ui:TextBox Text="{Binding Settings.IntroPath}" c:FileDrop.IsEnabled="True" />
                        </DockPanel>
                      </c:Field>
                      <c:Field Header="Outro" Margin="0">
                        <DockPanel>
                          <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Bỏ outro" Command="{Binding ClearFileCommand}" CommandParameter="outro" />
                          <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Chọn outro…" Command="{Binding PickCommand}" CommandParameter="outro" />
                          <ui:TextBox Text="{Binding Settings.OutroPath}" c:FileDrop.IsEnabled="True" />
                        </DockPanel>
                      </c:Field>
                    </StackPanel>
                  </ui:CardExpander>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="Âm thanh &amp; giọng">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,12,16,0">
                  <ui:Card Style="{StaticResource Section}">
                    <StackPanel>
                      <TextBlock Style="{StaticResource CardTitle}" Text="Tiếng gốc" />
                      <ui:ToggleSwitch Content="Tắt tiếng gốc" IsChecked="{Binding Settings.MuteOriginal}" Margin="0,0,0,8" />
                      <ui:ToggleSwitch Content="Ducking tự động (giảm tiếng gốc khi có giọng đọc)" IsChecked="{Binding Settings.SmartDucking}" Margin="0,0,0,8" />
                      <DockPanel Margin="0,0,0,12">
                        <ui:ToggleSwitch Content="Tách giọng gốc (giữ nhạc + hiệu ứng)" IsChecked="{Binding Settings.SeparateVocals}" Margin="0,0,16,0"
                                         ToolTip="Bỏ lời gốc khi xuất, giữ nhạc và hiệu ứng (AI worker, model tách giọng ở S16)" />
                        <ComboBox ItemTemplate="{StaticResource LabelItem}" ItemsSource="{x:Static local:ReupStudioViewModel.SeparationQualities}"
                                  SelectedItem="{Binding Settings.SeparationQuality}" IsEnabled="{Binding Settings.SeparateVocals}" MinWidth="220" HorizontalAlignment="Left" />
                      </DockPanel>
                      <c:Field Header="Âm lượng gốc">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueText}" Text="{Binding Settings.OriginalVolume, StringFormat={}{0:0.00}}" />
                          <Slider Minimum="0" Maximum="2" Value="{Binding Settings.OriginalVolume}" />
                        </DockPanel>
                      </c:Field>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="12" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="12" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <c:Field Header="Khử nhiễu" Margin="0">
                          <ComboBox ItemTemplate="{StaticResource LabelItem}" ItemsSource="{x:Static local:ReupStudioViewModel.DenoiseModes}" SelectedItem="{Binding Settings.Denoise}" />
                        </c:Field>
                        <c:Field Grid.Column="2" Header="Hiệu ứng giọng" Margin="0">
                          <ComboBox ItemsSource="{Binding Effects}" SelectedValuePath="Id" SelectedValue="{Binding Settings.VoiceEffect}" DisplayMemberPath="Name" />
                        </c:Field>
                        <c:Field Grid.Column="4" Header="Cao độ ±6" Margin="0">
                          <Slider Minimum="-6" Maximum="6" Value="{Binding Settings.Pitch}" TickFrequency="1" IsSnapToTickEnabled="True" />
                        </c:Field>
                      </Grid>
                    </StackPanel>
                  </ui:Card>
                  <ui:Card Style="{StaticResource Section}">
                    <StackPanel>
                      <TextBlock Style="{StaticResource CardTitle}" Text="Nhạc nền" />
                      <c:Field Header="File nhạc">
                        <DockPanel>
                          <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Bỏ nhạc nền" Command="{Binding ClearFileCommand}" CommandParameter="bgm" />
                          <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Chọn nhạc nền…" Command="{Binding PickCommand}" CommandParameter="bgm" />
                          <ui:TextBox Text="{Binding Settings.BgmPath}" c:FileDrop.IsEnabled="True" />
                        </DockPanel>
                      </c:Field>
                      <DockPanel>
                        <ui:ToggleSwitch DockPanel.Dock="Right" Content="Lặp" IsChecked="{Binding Settings.BgmLoop}" Margin="16,0,0,0" />
                        <TextBlock DockPanel.Dock="Left" Text="Âm lượng" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueText}" Text="{Binding Settings.BgmVolume, StringFormat={}{0:P0}}" />
                        <Slider Minimum="0" Maximum="1" Value="{Binding Settings.BgmVolume}" VerticalAlignment="Center" />
                      </DockPanel>
                    </StackPanel>
                  </ui:Card>
                  <ui:Card Style="{StaticResource Section}">
                    <StackPanel>
                      <TextBlock Style="{StaticResource CardTitle}" Text="Giọng đọc có sẵn" />
                      <c:Field Header="File giọng đọc">
                        <DockPanel>
                          <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Bỏ giọng đọc" Command="{Binding ClearFileCommand}" CommandParameter="voiceover" />
                          <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Chọn file giọng đọc…" Command="{Binding PickCommand}" CommandParameter="voiceover" />
                          <ui:TextBox Text="{Binding Settings.VoiceoverPath}" c:FileDrop.IsEnabled="True" />
                        </DockPanel>
                      </c:Field>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="140" />
                          <ColumnDefinition Width="12" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <c:Field Header="Bắt đầu tại (giây)" Margin="0">
                          <ui:TextBox Text="{Binding Settings.VoiceoverOffset}" />
                        </c:Field>
                        <c:Field Grid.Column="2" Header="Âm lượng" Margin="0">
                          <Slider Minimum="0" Maximum="2" Value="{Binding Settings.VoiceoverVolume}" />
                        </c:Field>
                      </Grid>
                    </StackPanel>
                  </ui:Card>
                  <ui:Card Style="{StaticResource Section}">
                    <StackPanel>
                      <TextBlock Style="{StaticResource CardTitle}" Text="Tạo giọng từ kịch bản" />
                      <TextBlock Style="{StaticResource Hint}" Margin="0,-6,0,12" Text="Đọc từng câu rồi tự sinh phụ đề khớp thời lượng thật." />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="12" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <c:Field Header="Ngôn ngữ">
                          <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" DisplayMemberPath="Display" />
                        </c:Field>
                        <c:Field Grid.Column="2" Header="Giọng">
                          <ComboBox ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}" DisplayMemberPath="DisplayName" />
                        </c:Field>
                      </Grid>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="12" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <c:Field Header="Tốc độ">
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueText}" Text="{Binding VoiceSpeed, StringFormat={}{0:0.00}x}" />
                            <Slider Minimum="0.8" Maximum="1.5" Value="{Binding VoiceSpeed}" />
                          </DockPanel>
                        </c:Field>
                        <c:Field Grid.Column="2" Header="Cao độ">
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueText}" Text="{Binding VoicePitch, StringFormat={}{0:+0;-0;0}}" />
                            <Slider Minimum="-6" Maximum="6" Value="{Binding VoicePitch}" />
                          </DockPanel>
                        </c:Field>
                      </Grid>
                      <ui:TextBox Text="{Binding ScriptText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="96"
                                  VerticalContentAlignment="Top" PlaceholderText="Nhập kịch bản cần đọc…" />
                      <ui:Button Content="Tạo giọng &amp; tự khớp phụ đề" Icon="{ui:SymbolIcon MicSparkle24}" Command="{Binding GenerateVoiceoverCommand}" Margin="0,12,0,0" />
                    </StackPanel>
                  </ui:Card>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="Phụ đề">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,12,16,0">
                <ui:CardExpander Style="{StaticResource Advanced}" Header="Kiểu phụ đề" Icon="{ui:SymbolIcon TextFont24}">
                  <StackPanel>
                    <WrapPanel Margin="0,0,0,12">
                      <ui:ToggleSwitch Content="Ép cứng phụ đề (hardsub)" IsChecked="{Binding Settings.BurnSubtitles}" Margin="0,0,24,0" />
                      <TextBlock Text="Mốc thời gian" VerticalAlignment="Center" Margin="0,0,8,0" />
                      <ComboBox ItemsSource="{x:Static local:ReupStudioViewModel.TimeBases}" SelectedItem="{Binding Settings.SubtitleTimeBase}" Width="110" />
                    </WrapPanel>
                    <DockPanel Margin="0,0,0,12">
                      <ui:Button DockPanel.Dock="Right" Content="Áp kiểu" Icon="{ui:SymbolIcon Checkmark24}" Command="{Binding ApplyStylePresetCommand}" Margin="8,0,0,0" />
                      <ComboBox ItemsSource="{Binding StylePresets}" SelectedItem="{Binding SelectedStylePreset}" DisplayMemberPath="Name" />
                    </DockPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <c:Field Header="Font">
                        <c:ValuePicker Options="{x:Static c:InputChoices.FontsList}" Value="{Binding Settings.FontName}" />
                      </c:Field>
                      <c:Field Grid.Column="2" Header="Cỡ" ToolTip="Cỡ chữ 16–48">
                        <ui:TextBox Text="{Binding Settings.FontSize}" />
                      </c:Field>
                      <c:Field Grid.Column="4" Header="Màu chữ">
                        <ui:TextBox Text="{Binding Settings.TextColor}" />
                      </c:Field>
                      <c:Field Grid.Column="6" Header="Màu viền">
                        <ui:TextBox Text="{Binding Settings.OutlineColor}" />
                      </c:Field>
                      <c:Field Grid.Column="8" Header="Viền" ToolTip="Độ dày viền 0–6">
                        <ui:TextBox Text="{Binding Settings.Outline}" />
                      </c:Field>
                    </Grid>
                    <DockPanel>
                      <ui:ToggleSwitch DockPanel.Dock="Right" Content="Nền hộp" IsChecked="{Binding Settings.BoxBackground}" Margin="16,0,0,0" />
                      <TextBlock DockPanel.Dock="Left" Text="Vị trí dọc" VerticalAlignment="Center" Margin="0,0,12,0" />
                      <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueText}" Text="{Binding Settings.PositionY, StringFormat={}{0:0}%}" />
                      <Slider Minimum="50" Maximum="95" Value="{Binding Settings.PositionY}" VerticalAlignment="Center" />
                    </DockPanel>
                  </StackPanel>
                </ui:CardExpander>
                <!-- Chiều cao cố định để danh sách + ô sửa câu không bị ép ở màn 1440x900; tab tự cuộn. -->
                <s02:SubtitleListPanel DataContext="{Binding Subtitles}" Height="460" />
              </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="Xuất &amp; nâng cao">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,12,16,0">
                  <ui:Card Style="{StaticResource Section}">
                    <StackPanel>
                      <TextBlock Style="{StaticResource CardTitle}" Text="Thư mục &amp; tên file" />
                      <c:Field Header="Thư mục xuất" Hint="Để trống = Videos\SuperMOOO\Reup">
                        <DockPanel>
                          <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Chọn thư mục xuất…"
                                     Command="{Binding ChooseOutputFolderCommand}" />
                          <ui:TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" c:FileDrop.IsEnabled="True" />
                        </DockPanel>
                      </c:Field>
                      <c:Field Header="Mẫu tên file" Hint="Dùng {name}, {preset}, {date}." Margin="0">
                        <ui:TextBox Text="{Binding Settings.FileNameTemplate}" />
                      </c:Field>
                    </StackPanel>
                  </ui:Card>
                  <ui:CardExpander Style="{StaticResource Advanced}" Header="Mã hoá video" Icon="{ui:SymbolIcon Settings24}">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="12" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="12" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition />
                          <RowDefinition />
                        </Grid.RowDefinitions>
                        <c:Field Header="Độ phân giải">
                          <ComboBox ItemsSource="{x:Static local:ReupStudioViewModel.Heights}" SelectedItem="{Binding Settings.Height}" />
                        </c:Field>
                        <c:Field Grid.Column="2" Header="FPS">
                          <ComboBox ItemsSource="{x:Static local:ReupStudioViewModel.FpsChoices}" SelectedItem="{Binding Settings.Fps}" />
                        </c:Field>
                        <c:Field Grid.Column="4" Header="Bitrate (kbps)">
                          <ui:TextBox Text="{Binding Settings.Bitrate}" />
                        </c:Field>
                        <c:Field Grid.Row="1" Header="Bộ mã hoá">
                          <ComboBox ItemsSource="{Binding Encoders}" SelectedItem="{Binding Settings.Encoder}" />
                        </c:Field>
                        <c:Field Grid.Row="1" Grid.Column="2" Header="Preset mã hoá">
                          <ComboBox ItemsSource="{Binding EncodePresets}" SelectedItem="{Binding Settings.EncodePreset}" />
                        </c:Field>
                        <c:Field Grid.Row="1" Grid.Column="4" Header="Khi giọng dài hơn video">
                          <ComboBox ItemsSource="{x:Static local:ReupStudioViewModel.VoiceLongerModes}" SelectedItem="{Binding Settings.WhenVoiceLonger}" />
                        </c:Field>
                      </Grid>
                      <ui:ToggleSwitch Content="Xoá metadata, chapter, tag encoder của file gốc" IsChecked="{Binding Settings.StripMetadata}" />
                    </StackPanel>
                  </ui:CardExpander>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
          </TabControl>
        </DockPanel>
      </c:SplitView.Primary>

      <c:SplitView.Secondary>
        <DockPanel>
          <ui:Card DockPanel.Dock="Bottom" Style="{StaticResource Section}" Margin="0,12,0,0">
            <StackPanel>
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Mốc xem trước" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueText}" Text="{Binding ScrubSeconds, StringFormat={}{0:0} s}" />
                <Slider Minimum="0" Maximum="600" Value="{Binding ScrubSeconds}" VerticalAlignment="Center" />
              </DockPanel>
              <WrapPanel Margin="0,12,0,0">
                <ui:Button Content="Xem đoạn 6 s" Icon="{ui:SymbolIcon Play24}" Command="{Binding PreviewClipCommand}" Margin="0,0,8,8" />
                <ui:Button Content="Chụp khung" Icon="{ui:SymbolIcon Camera24}" Command="{Binding PreviewFrameCommand}" Margin="0,0,8,8" />
                <ui:Button Content="Xuất hàng loạt" Icon="{ui:SymbolIcon VideoClipMultiple24}" Command="{Binding ExportBatchCommand}" Margin="0,0,8,8" />
                <ui:Button Content="Mở kết quả" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenOutputCommand}" Margin="0,0,8,8" />
                <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Mở thư mục kết quả" Command="{Binding OpenOutputFolderCommand}" Margin="0,0,0,8" />
              </WrapPanel>
              <Expander Header="Nhật ký" Margin="0,4,0,0">
                <ListBox ItemsSource="{Binding Log}" Height="100" FontSize="12" />
              </Expander>
            </StackPanel>
          </ui:Card>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" MinHeight="120" />
              <RowDefinition Height="12" />
              <RowDefinition Height="1.3*" MinHeight="160" />
            </Grid.RowDefinitions>
            <Border x:Name="FrameContainer" CornerRadius="{StaticResource Radius}" Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
              <Grid>
                <c:EmptyState x:Name="FrameEmpty" Icon="Image24" Text="Bấm Chụp khung để xem trước một khung hình với thiết lập hiện tại." />
                <Image x:Name="Frame" Stretch="Uniform" Margin="4" />
                <ui:Button x:Name="ExpandFrameButton" Icon="{ui:SymbolIcon FullScreenMaximize24}" ToolTip="Phóng to khung xem trước (Esc để thu nhỏ)"
                           Click="ExpandFrameClick" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
                  <ui:Button.Style>
                    <Style TargetType="ui:Button" BasedOn="{StaticResource IconButton}">
                      <Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=Frame}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers>
                    </Style>
                  </ui:Button.Style>
                </ui:Button>
              </Grid>
            </Border>
            <ContentControl x:Name="ClipHost" Grid.Row="2" Focusable="False" />
          </Grid>
        </DockPanel>
      </c:SplitView.Secondary>
    </c:SplitView>
  </DockPanel>
</UserControl>
