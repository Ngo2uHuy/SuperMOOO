<UserControl x:Class="SuperMOOO.App.Features.S01.LocalizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:SuperMOOO.App.Controls"
             xmlns:local="clr-namespace:SuperMOOO.App.Features.S01">
  <DockPanel Margin="{StaticResource PagePadding}">
    <c:ScreenHeader DockPanel.Dock="Top" Title="Lồng tiếng video"
                    Description="Nhận diện lời thoại, dịch, đọc lại bằng giọng AI rồi ghép vào video kèm phụ đề và nhạc nền.">
      <ui:Button Appearance="Primary" Content="Chạy video đang chọn" Icon="{ui:SymbolIcon Play24}" Command="{Binding RunSingleCommand}" />
    </c:ScreenHeader>

    <c:SplitView PrimaryRatio="1.15">
      <c:SplitView.Primary>
        <DockPanel>
          <ui:Card DockPanel.Dock="Top" Style="{StaticResource Section}" Margin="0,0,16,12">
            <StackPanel>
              <DockPanel Margin="0,0,0,12">
                <TextBlock Style="{StaticResource CardTitle}" Text="Nguồn" Margin="0" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <RadioButton Content="Lồng tiếng video" IsChecked="True" GroupName="mode" Margin="0,0,16,0" />
                  <RadioButton Content="Chỉ phụ đề (ASR, dịch, hardsub)" IsChecked="{Binding SubtitlesOnly}" GroupName="mode" />
                </StackPanel>
              </DockPanel>
              <DockPanel>
                <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Chọn thư mục video…"
                           Command="{Binding BrowseFolderCommand}" />
                <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon VideoAdd24}" ToolTip="Chọn file video…"
                           Command="{Binding BrowseFileCommand}" />
                <ui:TextBox Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}" c:FileDrop.IsEnabled="True"
                            PlaceholderText="Kéo thả video hoặc thư mục vào đây, hoặc bấm chọn bên phải" />
              </DockPanel>
              <DockPanel Margin="0,8,0,0" Visibility="{Binding Sources.Count, Converter={StaticResource NotEmptyToVis}}">
                <ui:Button DockPanel.Dock="Right" Content="Quét 2 lớp" Icon="{ui:SymbolIcon FolderSearch24}" Command="{Binding ScanDeepCommand}" Margin="8,0,0,0"
                           ToolTip="Tìm video trong thư mục và thư mục con" />
                <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" ToolTip="Video sẽ chạy khi bấm Chạy video đang chọn" />
              </DockPanel>
            </StackPanel>
          </ui:Card>


          <TabControl>
            <TabItem Header="1. Nhận diện">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,12,16,0">
                  <ui:Card Style="{StaticResource Section}">
                    <StackPanel>
                      <TextBlock Style="{StaticResource CardTitle}" Text="Các bước sẽ chạy" />
                      <WrapPanel>
                        <CheckBox Content="Lấy phụ đề (ASR)" IsChecked="{Binding UseAsr}" Width="240" Margin="0,0,12,8" />
                        <CheckBox Content="Dùng phụ đề đã chỉnh ở S02" IsChecked="{Binding UseEditedSubtitles}" Width="240" Margin="0,0,12,8" />
                        <CheckBox Content="Dịch phụ đề" IsChecked="{Binding Translate}" Width="240" Margin="0,0,12,8" />
                        <CheckBox Content="Tạo giọng đọc" IsChecked="{Binding Dub}" Width="240" Margin="0,0,12,8" />
                        <CheckBox Content="Gắn phụ đề khi xuất" IsChecked="{Binding BurnSubtitles}" Width="240" Margin="0,0,12,8" />
                        <CheckBox Content="Lật gương" IsChecked="{Binding Mirror}" Width="240" Margin="0,0,12,8" />
                        <CheckBox Content="Xén 1.5 s đầu (lách meta)" IsChecked="{Binding CutMeta}" Width="240" Margin="0,0,12,8" />
                        <CheckBox Content="Giữ cache nhận diện" IsChecked="{Binding ReuseCache}" Width="240" Margin="0,0,12,8" />
                      </WrapPanel>
                    </StackPanel>
                  </ui:Card>
                  <ui:Card Style="{StaticResource Section}">
                    <StackPanel>
                      <TextBlock Style="{StaticResource CardTitle}" Text="Nhận diện giọng nói" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="1.6*" />
                          <ColumnDefinition Width="12" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="12" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <c:Field Header="Ngôn ngữ nguồn">
                          <ComboBox ItemsSource="{Binding SourceLanguages}" SelectedItem="{Binding SourceLanguage}" DisplayMemberPath="Display" />
                        </c:Field>
                        <c:Field Grid.Column="2" Header="Model ASR">
                          <ui:TextBox Text="{Binding AsrModel, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Theo Cài đặt" />
                        </c:Field>
                        <c:Field Grid.Column="4" Header="Khử nhiễu" ToolTip="Lọc tiếng thở / khử nhiễu trước khi nhận diện">
                          <ComboBox ItemTemplate="{StaticResource LabelItem}" ItemsSource="{Binding DenoiseModes}" SelectedItem="{Binding DenoiseMode}" />
                        </c:Field>
                      </Grid>
                      <WrapPanel>
                        <ui:Button Content="Bóc phụ đề gốc" Icon="{ui:SymbolIcon MicSparkle24}" Command="{Binding TranscribeCommand}" Margin="0,0,8,0"
                                   ToolTip="Chỉ chạy ASR; sau đó mở S02 để chỉnh sửa" />
                        <ui:Button Content="Xoá cache nhận diện" Icon="{ui:SymbolIcon Delete24}" Command="{Binding ClearCacheCommand}" />
                      </WrapPanel>
                    </StackPanel>
                  </ui:Card>
                  <ui:Card Style="{StaticResource Section}">
                    <c:Field Header="Câu mẫu để dịch / đọc thử" Margin="0">
                      <ui:TextBox Text="{Binding SubPreview, UpdateSourceTrigger=PropertyChanged}" />
                    </c:Field>
                  </ui:Card>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="2. Dịch">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,12,16,0">
                  <ui:Card Style="{StaticResource Section}">
                    <StackPanel>
                      <TextBlock Style="{StaticResource CardTitle}" Text="Bản dịch" />
                      <TextBlock Style="{StaticResource Hint}" Margin="0,-6,0,12" Text="Dịch vụ dịch và ASR chọn ở Cài đặt → Model AI." />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="12" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <c:Field Header="Ngôn ngữ đích">
                          <ComboBox ItemsSource="{Binding TargetLanguages}" SelectedItem="{Binding TargetLanguage}" DisplayMemberPath="Display" />
                        </c:Field>
                        <c:Field Grid.Column="2" Header="Ngữ cảnh">
                          <ComboBox ItemsSource="{x:Static local:LocalizeViewModel.Contexts}" SelectedItem="{Binding TranslationContext}" />
                        </c:Field>
                      </Grid>
                      <ui:Button Content="Dịch câu mẫu" Icon="{ui:SymbolIcon Translate24}" Command="{Binding TranslateSampleCommand}" />
                    </StackPanel>
                  </ui:Card>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="3. Giọng">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,12,16,0">
                  <ui:Card Style="{StaticResource Section}">
                    <StackPanel>
                      <TextBlock Style="{StaticResource CardTitle}" Text="Giọng đọc" />
                      <c:Field Header="Giọng">
                        <DockPanel>
                          <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Stop24}" ToolTip="Dừng phát" Command="{Binding StopAudioCommand}" />
                          <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Speaker224}" ToolTip="Nghe thử giọng với câu mẫu"
                                     Command="{Binding PreviewVoiceCommand}" />
                          <ComboBox ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}" DisplayMemberPath="DisplayName" />
                        </DockPanel>
                      </c:Field>
                      <c:Field Header="Tốc độ đọc">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueText}" Text="{Binding Speed, StringFormat={}{0:0.00}x}" />
                          <Slider Minimum="0.8" Maximum="1.5" Value="{Binding Speed}" TickFrequency="0.05" IsSnapToTickEnabled="True" />
                        </DockPanel>
                      </c:Field>
                      <CheckBox Content="Tự ép tốc độ nếu câu dịch dài hơn câu gốc" IsChecked="{Binding AutoFit}" Margin="0,0,0,8" />
                      <CheckBox Content="Bỏ qua câu TTS lỗi (ghi vào báo cáo)" IsChecked="{Binding SkipFailedSentences}" />
                    </StackPanel>
                  </ui:Card>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="4. Hình &amp; tiếng">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,12,16,0">
                  <ui:Card Style="{StaticResource Section}">
                    <StackPanel>
                      <TextBlock Style="{StaticResource CardTitle}" Text="Phụ đề" />
                      <DockPanel Margin="0,0,0,12">
                        <ui:Button DockPanel.Dock="Right" Content="Áp kiểu" Icon="{ui:SymbolIcon Checkmark24}" Command="{Binding ApplyStylePresetCommand}" Margin="8,0,0,0" />
                        <ComboBox ItemsSource="{Binding StylePresets}" SelectedItem="{Binding SelectedStylePreset}" DisplayMemberPath="Name" />
                      </DockPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="1.6*" />
                          <ColumnDefinition Width="8" />
                          <ColumnDefinition Width="0.8*" />
                          <ColumnDefinition Width="8" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="8" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <c:Field Header="Font">
                          <ComboBox ItemsSource="{Binding Fonts}" Text="{Binding FontName}" IsEditable="True" />
                        </c:Field>
                        <c:Field Grid.Column="2" Header="Cỡ chữ">
                          <ui:TextBox Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged}" />
                        </c:Field>
                        <c:Field Grid.Column="4" Header="Màu chữ">
                          <ui:TextBox Text="{Binding TextColor, UpdateSourceTrigger=PropertyChanged}" />
                        </c:Field>
                        <c:Field Grid.Column="6" Header="Màu nền">
                          <ui:TextBox Text="{Binding BackColor, UpdateSourceTrigger=PropertyChanged}" />
                        </c:Field>
                      </Grid>
                      <WrapPanel Margin="0,0,0,12">
                        <CheckBox Content="Nền hộp" IsChecked="{Binding BoxBackground}" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <CheckBox Content="Đổi màu chạy theo từng từ" IsChecked="{Binding Karaoke}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ui:TextBox Text="{Binding WordColor, UpdateSourceTrigger=PropertyChanged}" Width="110" ToolTip="Màu chữ khi đang nói" />
                      </WrapPanel>
                      <c:Field Header="Vị trí dọc" Margin="0">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueText}" Text="{Binding SubtitleY, StringFormat={}{0:0}%}" />
                          <Slider Minimum="0" Maximum="100" Value="{Binding SubtitleY}" />
                        </DockPanel>
                      </c:Field>
                    </StackPanel>
                  </ui:Card>

                  <ui:Card Style="{StaticResource Section}">
                    <StackPanel>
                      <TextBlock Style="{StaticResource CardTitle}" Text="Âm thanh &amp; nhạc nền" />
                      <WrapPanel Margin="0,0,0,12">
                        <ui:ToggleSwitch Content="Tắt tiếng gốc" IsChecked="{Binding MuteOriginal}" Margin="0,0,24,0" />
                        <ui:ToggleSwitch Content="Ducking tự động" IsChecked="{Binding SmartAudio}" Margin="0,0,24,0" />
                        <ui:ToggleSwitch Content="Tách giọng gốc" IsChecked="{Binding SeparateVocals}" Margin="0,0,24,0"
                                         ToolTip="Giữ nhạc và hiệu ứng, chỉ bỏ lời gốc (AI worker, model tách giọng ở S16)" />
                        <ComboBox ItemTemplate="{StaticResource LabelItem}" ItemsSource="{Binding SeparationQualities}" SelectedItem="{Binding SeparationQuality}"
                                  IsEnabled="{Binding SeparateVocals}" MinWidth="220" Margin="0,0,24,0" ToolTip="Model tách giọng" />
                        <ui:Button Content="Smart Audio" Icon="{ui:SymbolIcon Sparkle24}" Command="{Binding ApplySmartAudioCommand}"
                                   ToolTip="Tự đặt mức tiếng gốc/giọng đọc hợp lý" />
                      </WrapPanel>
                      <c:Field Header="Tiếng gốc">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueText}" Text="{Binding OriginalDb, StringFormat={}{0:0} dB}" />
                          <Slider Minimum="-30" Maximum="0" Value="{Binding OriginalDb}" />
                        </DockPanel>
                      </c:Field>
                      <c:Field Header="Giọng đọc">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueText}" Text="{Binding VoiceDb, StringFormat={}{0:0} dB}" />
                          <Slider Minimum="-30" Maximum="6" Value="{Binding VoiceDb}" />
                        </DockPanel>
                      </c:Field>
                      <DockPanel Margin="0,0,0,8">
                        <ui:Button DockPanel.Dock="Right" Content="Xoá hết" Icon="{ui:SymbolIcon Delete24}" Command="{Binding ClearBgmCommand}" Margin="12,0,0,0" />
                        <ui:ToggleSwitch DockPanel.Dock="Left" Content="Nhạc nền xoay vòng" IsChecked="{Binding BgmEnabled}" Margin="0,0,16,0" />
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueText}" Text="{Binding BgmPercent, StringFormat={}{0:0}%}" />
                        <Slider Minimum="0" Maximum="100" Value="{Binding BgmPercent}" VerticalAlignment="Center" AutomationProperties.Name="Âm lượng nhạc nền" />
                      </DockPanel>
                      <ItemsControl ItemsSource="{Binding BgmSlots}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <ui:Button Content="{Binding Label}" Icon="{ui:SymbolIcon MusicNote224}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2"
                                       Command="{Binding DataContext.PickBgmCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </ui:Card>

                  <ui:CardExpander Style="{StaticResource Advanced}" Header="Làm mờ phụ đề cũ" Icon="{ui:SymbolIcon EyeOff24}">
                    <StackPanel>
                      <WrapPanel Margin="0,0,0,12">
                        <ui:ToggleSwitch Content="Bật làm mờ" IsChecked="{Binding BlurEnabled}" Margin="0,0,24,0" />
                        <ui:ToggleSwitch Content="Chỉ mờ khi có phụ đề" IsChecked="{Binding BlurOnlyDuringSubtitles}" />
                      </WrapPanel>
                      <c:Field Header="Vùng (x,y,w,h theo %)">
                        <ui:TextBox Text="{Binding BlurBoxText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="0,80,100,20" />
                      </c:Field>
                      <WrapPanel Margin="0,0,0,8">
                        <ui:Button Content="Tự tìm vùng phụ đề gốc" Icon="{ui:SymbolIcon ScanText24}" Command="{Binding LocateSubtitlesCommand}" Margin="0,0,16,8"
                                   ToolTip="Lấy mẫu ~48 khung, tìm dải chữ lặp lại (bỏ logo cố định) rồi điền vào ô Vùng" />
                        <CheckBox Content="Che theo lúc có chữ" IsChecked="{Binding BlurOnText}" Margin="0,0,16,8"
                                  ToolTip="Dò chữ trong vùng (AI worker) để chỉ làm mờ lúc phụ đề gốc hiện, thay cho mốc phụ đề mới" />
                        <CheckBox Content="Xoá phụ đề gốc (inpaint, chậm)" IsChecked="{Binding InpaintSubtitles}" Margin="0,0,0,8"
                                  ToolTip="Vẽ lại nền chỗ có chữ thay cho làm mờ" />
                      </WrapPanel>
                      <WrapPanel Margin="0,0,0,8" Visibility="{Binding InpaintSubtitles, Converter={StaticResource BoolToVis}}">
                        <RadioButton Content="Chất lượng" GroupName="InpaintMode" IsChecked="{Binding InpaintQuality}" Margin="0,0,16,0" />
                        <RadioButton Content="Nhanh" GroupName="InpaintMode" IsChecked="{Binding InpaintFast}" Margin="0,0,16,0" />
                        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Text="Nhanh: ~2× nhanh hơn, nền chuyển động có thể hơi vệt."
                                   Visibility="{Binding InpaintFast, Converter={StaticResource BoolToVis}}" />
                      </WrapPanel>
                      <TextBlock Style="{StaticResource Hint}" Margin="0,-4,0,12" Text="Xoá phụ đề gốc rất chậm trên CPU (~5–25 phút cho 1 phút video 1080p) và có thể để lại vệt; mặc định nên dùng làm mờ."
                                 Visibility="{Binding InpaintSubtitles, Converter={StaticResource BoolToVis}}" TextWrapping="Wrap" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="12" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <c:Field Header="Độ mờ" Margin="0">
                          <Slider Minimum="1" Maximum="50" Value="{Binding BlurStrength}" />
                        </c:Field>
                        <c:Field Grid.Column="2" Header="Mềm viền" Margin="0">
                          <Slider Minimum="0" Maximum="30" Value="{Binding BlurFeather}" />
                        </c:Field>
                      </Grid>
                    </StackPanel>
                  </ui:CardExpander>

                  <ui:CardExpander Style="{StaticResource Advanced}" Header="Tỉ lệ khung &amp; tệp chèn" Icon="{ui:SymbolIcon ResizeVideo24}">
                    <StackPanel>
                      <c:Field Header="Tỉ lệ khung">
                        <ComboBox ItemTemplate="{StaticResource LabelItem}" ItemsSource="{Binding Aspects}" SelectedItem="{Binding AspectRatio}" Width="160" HorizontalAlignment="Left" />
                      </c:Field>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="80" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="120" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition />
                          <RowDefinition />
                          <RowDefinition />
                          <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Logo" VerticalAlignment="Center" />
                        <ui:TextBox Grid.Column="1" Text="{Binding LogoFile}" Margin="0,4" c:FileDrop.IsEnabled="True" />
                        <ui:TextBox Grid.Column="2" Text="{Binding LogoBoxText, UpdateSourceTrigger=PropertyChanged}" Margin="8,4,0,4" ToolTip="Vùng x,y,w,h (%)" />
                        <ui:Button Grid.Column="3" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Chọn logo…" Command="{Binding PickCommand}" CommandParameter="logo" Margin="4,4,0,4" />
                        <TextBlock Grid.Row="1" Text="Canvas" VerticalAlignment="Center" />
                        <ui:TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CanvasFile}" Margin="0,4" c:FileDrop.IsEnabled="True" />
                        <ui:TextBox Grid.Row="1" Grid.Column="2" Text="{Binding CanvasBoxText, UpdateSourceTrigger=PropertyChanged}" Margin="8,4,0,4" ToolTip="Vùng x,y,w,h (%)" />
                        <ui:Button Grid.Row="1" Grid.Column="3" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Chọn ảnh canvas…" Command="{Binding PickCommand}" CommandParameter="canvas" Margin="4,4,0,4" />
                        <TextBlock Grid.Row="2" Text="Video PiP" VerticalAlignment="Center" />
                        <ui:TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PipFile}" Margin="0,4" c:FileDrop.IsEnabled="True" />
                        <ui:TextBox Grid.Row="2" Grid.Column="2" Text="{Binding PipBoxText, UpdateSourceTrigger=PropertyChanged}" Margin="8,4,0,4" ToolTip="Vùng x,y,w,h (%)" />
                        <ui:Button Grid.Row="2" Grid.Column="3" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Chọn video PiP…" Command="{Binding PickCommand}" CommandParameter="pip" Margin="4,4,0,4" />
                        <TextBlock Grid.Row="3" Text="Outro" VerticalAlignment="Center" />
                        <ui:TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding OutroFile}" Margin="0,4" c:FileDrop.IsEnabled="True" />
                        <ui:Button Grid.Row="3" Grid.Column="3" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Chọn video outro…" Command="{Binding PickCommand}" CommandParameter="outro" Margin="4,4,0,4" />
                      </Grid>
                    </StackPanel>
                  </ui:CardExpander>

                  <ui:CardExpander Style="{StaticResource Advanced}" Header="Chế độ chỉ phụ đề: che vùng chữ cũ" Icon="{ui:SymbolIcon RectangleLandscape24}">
                    <WrapPanel>
                      <ui:ToggleSwitch Content="Che vùng chữ cũ" IsChecked="{Binding MaskEnabled}" Margin="0,0,24,0" />
                      <ComboBox ItemsSource="{Binding MaskRegions}" SelectedItem="{Binding MaskRegion}" Width="140" Margin="0,0,8,0" ToolTip="Vùng che" />
                      <ComboBox ItemsSource="{Binding MaskStyles}" SelectedItem="{Binding MaskStyle}" Width="130" ToolTip="Kiểu che" />
                    </WrapPanel>
                  </ui:CardExpander>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
          </TabControl>
        </DockPanel>
      </c:SplitView.Primary>

      <c:SplitView.Secondary>
        <DockPanel>
          <!-- Khung tác vụ và thanh trạng thái nằm ở cột phải để các tab thiết lập bên trái có đủ chiều cao. -->
          <c:ScreenJobsPanel x:Name="ScreenJobs" DockPanel.Dock="Bottom" Margin="0,12,0,0" />
          <c:JobStatusBar DockPanel.Dock="Bottom" Margin="0,12,0,0" />
          <ui:Card DockPanel.Dock="Bottom" Style="{StaticResource Section}" Margin="0,12,0,0">
            <StackPanel>
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Khung xem trước" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Camera24}" ToolTip="Chụp khung / làm ảnh bìa"
                           Command="{Binding SnapshotCommand}" Margin="8,0,0,0" />
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueText}" Text="{Binding ScrubSeconds, StringFormat={}{0:0} s}" />
                <Slider Minimum="0" Maximum="{Binding ScrubMax}" Value="{Binding ScrubSeconds}" VerticalAlignment="Center" AutomationProperties.Name="Khung xem trước" />
              </DockPanel>
              <WrapPanel Margin="0,12,0,0">
                <ui:Button Content="Chạy hàng loạt" Icon="{ui:SymbolIcon VideoClipMultiple24}" Command="{Binding RunAutoBatchCommand}" Margin="0,0,8,8"
                           ToolTip="Đưa mọi video trong danh sách nguồn vào hàng đợi (theo dõi ở khung Tác vụ của màn này)" />
                <ui:Button Content="Mở kết quả" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenOutputCommand}" Margin="0,0,8,8" />
                <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Mở thư mục kết quả" Command="{Binding OpenOutputFolderCommand}" Margin="0,0,0,8" />
              </WrapPanel>
              <Expander Header="Nhật ký" Margin="0,4,0,0">
                <ListBox ItemsSource="{Binding Log}" Height="100" FontSize="12" />
              </Expander>
            </StackPanel>
          </ui:Card>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" MinHeight="120" />
              <RowDefinition Height="12" />
              <RowDefinition Height="1.3*" MinHeight="160" />
            </Grid.RowDefinitions>
            <Border x:Name="FrameContainer" CornerRadius="{StaticResource Radius}" Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
              <Grid>
                <c:EmptyState x:Name="FrameEmpty" Icon="Image24" Text="Chọn video và kéo thanh Khung xem trước để xem một khung hình." />
                <Image x:Name="Frame" Stretch="Uniform" Margin="4" />
                <!-- Thứ tự là lớp vẽ: canvas thường phủ cả khung nên nằm dưới cùng để không che các vùng nhỏ. -->
                <c:RegionOverlay Source="{Binding Source, ElementName=Frame}" Margin="4">
                  <c:BoxRegion Label="Canvas" Stroke="#7C4DFF" Box="{Binding CanvasBoxText}" IsActive="{Binding DubLayout}"
                               Visibility="{Binding CanvasFile, Converter={StaticResource NotEmptyToVis}}" />
                  <c:BoxRegion Label="Vùng che" Stroke="#E53935" Box="{Binding MaskBoxText, Mode=OneWay}" IsActive="{Binding SubtitlesOnly}" IsHitTestVisible="False"
                               Visibility="{Binding MaskEnabled, Converter={StaticResource BoolToVis}}" />
                  <c:BoxRegion Label="Làm mờ" Stroke="#00B7C3" Box="{Binding BlurBoxText}" IsActive="{Binding DubLayout}"
                               Visibility="{Binding BlurEnabled, Converter={StaticResource BoolToVis}}" />
                  <c:SubtitleRegion Label="Phụ đề" Stroke="#FFD600" Y="{Binding SubtitleY}" Left="{Binding SubtitleLeft}" Width="{Binding SubtitleWidth}"
                                    TextSize="{Binding FontSize}" FontName="{Binding FontName}"
                                    Text="{Binding SubPreview}" IsActive="{Binding DubLayout}"
                                    Visibility="{Binding BurnSubtitles, Converter={StaticResource BoolToVis}}" />
                  <c:BoxRegion Label="PiP" Stroke="#FF9100" Box="{Binding PipBoxText}" IsActive="{Binding DubLayout}"
                               Visibility="{Binding PipFile, Converter={StaticResource NotEmptyToVis}}" />
                  <c:BoxRegion Label="Logo" Stroke="#FF4081" Box="{Binding LogoBoxText}" IsActive="{Binding DubLayout}"
                               Visibility="{Binding LogoFile, Converter={StaticResource NotEmptyToVis}}" />
                </c:RegionOverlay>
                <ui:Button x:Name="ExpandFrameButton" Icon="{ui:SymbolIcon FullScreenMaximize24}" ToolTip="Phóng to khung xem trước (Esc để thu nhỏ)"
                           Click="ExpandFrameClick" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
                  <ui:Button.Style>
                    <Style TargetType="ui:Button" BasedOn="{StaticResource IconButton}">
                      <Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=Frame}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers>
                    </Style>
                  </ui:Button.Style>
                </ui:Button>
              </Grid>
            </Border>
            <ContentControl x:Name="ResultHost" Grid.Row="2" Focusable="False" />
          </Grid>
        </DockPanel>
      </c:SplitView.Secondary>
    </c:SplitView>
  </DockPanel>
</UserControl>
