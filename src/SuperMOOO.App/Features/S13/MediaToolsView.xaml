<UserControl x:Class="SuperMOOO.App.Features.S13.MediaToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:SuperMOOO.App.Controls">
  <DockPanel Margin="{StaticResource PagePadding}">
    <c:ScreenHeader DockPanel.Dock="Top" Title="Công cụ media"
                    Description="Chọn công cụ bên trái, điền thông số rồi bấm Chạy; file kết quả mở được ngay sau khi xong.">
      <ui:Button x:Name="RunButton" Appearance="Primary" Content="Chạy" Icon="{ui:SymbolIcon Play24}" />
    </c:ScreenHeader>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <ui:Card Style="{StaticResource FillSection}" Margin="0" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="Công cụ" Margin="8,8,8,8" />
          <ui:ListView ItemsSource="{Binding Operations}" SelectedItem="{Binding Selected}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ui:ListView.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Label}" Margin="4,8" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ui:ListView.ItemTemplate>
          </ui:ListView>
        </DockPanel>
      </ui:Card>

      <DockPanel Grid.Column="2">
        <c:ScreenJobsPanel x:Name="ScreenJobs" DockPanel.Dock="Bottom" Margin="0,12,0,0" />
        <c:JobStatusBar DockPanel.Dock="Bottom" Margin="0,12,0,0" />
        <ui:Card DockPanel.Dock="Bottom" Style="{StaticResource Section}" Margin="0,12,0,0">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <TextBlock Style="{StaticResource CardTitle}" Text="Kết quả" Margin="0" VerticalAlignment="Center" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Mở file" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenFileCommand}" />
                <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Mở thư mục chứa file kết quả"
                           Command="{Binding OpenFolderCommand}" />
              </StackPanel>
            </DockPanel>
            <ui:TextBox Text="{Binding ResultText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="110"
                        VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" PlaceholderText="Thông tin kết quả sẽ hiện ở đây." />
          </DockPanel>
        </ui:Card>
        <ui:Card Style="{StaticResource FillSection}" Margin="0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="{Binding Selected.Label, FallbackValue=Thiết lập}" />
            <ContentControl x:Name="FormHost" Focusable="False" />
          </DockPanel>
        </ui:Card>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
